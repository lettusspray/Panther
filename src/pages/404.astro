---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="Page not found" posture="walking" description="This page doesn't exist on Panther.">
  <div class="container-walking" style="padding-top: 96px; padding-bottom: 128px; text-align: center; max-width: 560px;">
    <h1 style="font-family: var(--posture-font); font-size: 32px; color: var(--panther-resting-hex); margin-bottom: 12px;">
      Page not found
    </h1>
    <p style="font-family: var(--font-sans); font-size: 15px; color: var(--panther-eyes-hex); line-height: 1.6; margin-bottom: 24px;">
      The page you're after doesn't exist or has moved.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <Button label="Browse Listings" href="/listings" variant="primary" size="md" />
      <Button label="Back home" href="/" variant="secondary" size="md" />
    </div>
  </div>
</BaseLayout>
