---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleCard from "../../components/VehicleCard.astro";
import { getDealerBySlug, getDealerListings, getDealerReviews, getDealerStats, getDealerCommitment, getDealerInventoryQuality, getDealerReliability, getDealerCareEvents } from "../../lib/dealer";
import { dealerJsonLd, breadcrumbJsonLd } from "../../lib/seo";
const dealer = Astro.params.slug ? await getDealerBySlug(Astro.params.slug) : null;
if (!dealer) Astro.response.status = 404;
let listings:any[] = [], stats:any = { total:0, active:0, sold:0, avgRating:null, reviewCount:0 }, commitment:any = null, quality:any = { averageScore:0, listings:[] }, reliability:any = { completedOrders:0, trackedOrders:0, settlementRate:null }, care:any[] = [];
if (dealer) [listings,,stats,commitment,quality,reliability,care] = await Promise.all([getDealerListings(dealer.userId,"active"),getDealerReviews(dealer.id),getDealerStats(dealer.userId),getDealerCommitment(dealer.id),getDealerInventoryQuality(dealer.userId),getDealerReliability(dealer.userId),getDealerCareEvents(dealer.id,12)]);
const dealerListings = listings.map((x:any)=>({...x,businessName:dealer?.businessName,dealerVerified:dealer?.isVerified}));
const schema = dealer ? { "@context":"https://schema.org", "@graph":[dealerJsonLd({name:dealer.businessName,url:`/dealers/${dealer.slug}`,phone:dealer.contactPhone,city:dealer.city,state:dealer.state,description:dealer.about}), breadcrumbJsonLd([{name:"Dealers",url:"/dealers"},{name:dealer.businessName,url:`/dealers/${dealer.slug}`}])]} : undefined;
---
<BaseLayout title={`${dealer?.businessName||"Dealer"} — Panther`} description={dealer?.about||`Vehicle dealer profile for ${dealer?.businessName||"a Panther seller"}.`} schema={schema}>
<section class="dealer-hero"><div class="shell"><a class="back-link" href="/dealers">← Dealer network</a>{dealer?<div class="dealer-heading"><div><div class="dealer-name-row"><h1>{dealer.businessName}</h1>{dealer.isVerified&&<span class="verified">Verified business</span>}</div><p class="lead">{[dealer.city,dealer.state].filter(Boolean).join(", ")||"Nigeria"}</p></div><div class="dealer-actions">{dealer.whatsappNumber&&<a class="button primary" href={`https://wa.me/${Array.from(dealer.whatsappNumber).filter((char)=>char>="0"&&char<="9").join("")}`}>WhatsApp</a>}{dealer.contactPhone&&<a class="button secondary" href={`tel:${dealer.contactPhone}`}>Call</a>}</div></div><div class="dealer-stats"><div><b>{stats.active}</b><span>Active cars</span></div><div><b>{stats.sold}</b><span>Sold</span></div><div><b>{stats.avgRating??"—"}</b><span>{stats.reviewCount?`${stats.reviewCount} reviews`:"Reviews"}</span></div><div><b>{reliability.completedOrders}</b><span>Settled orders</span></div><div><b>{quality.averageScore}%</b><span>Inventory quality</span></div></div></div></section>
<section class="section"><div class="shell dealer-layout"><div><div class="section-head"><div><p class="eyebrow">INVENTORY</p><h2>Current vehicles</h2></div></div>{dealerListings.length?<div class="vehicle-grid">{dealerListings.map((l)=><VehicleCard listing={l}/>)}</div>:<div class="empty-state"><h3>No active inventory</h3><p>This dealer currently has no active vehicles.</p></div>}
{care.length>0&&<div class="info-card"><p class="eyebrow">VEHICLE CARE & RECORDS</p>{care.map((x:any)=><div class="ops-row"><div><b>{x.title}</b><span>{new Date(x.eventDate).toLocaleDateString("en-NG")} · {x.type.replaceAll("_"," ")}</span></div>{x.mileageKm&&<span>{new Intl.NumberFormat("en-NG").format(x.mileageKm)} km</span>}</div>)}</div>}
</div><aside class="dealer-sidebar"><div class="info-card"><p class="eyebrow">WHAT PANTHER VERIFIED</p><ul class="check-list"><li>{dealer.isVerified?"Business identity verified":"Business identity not yet verified"}</li><li>{dealer.naddcRegistrationId?`NADDC registration: ${dealer.naddcRegistrationId}`:"NADDC registration not listed"}</li><li>{dealer.inspectionAvailable?"Vehicle inspection available":"Inspection not listed"}</li><li>{dealer.deliveryAvailable?"Delivery available":"Delivery not listed"}</li></ul></div><div class="info-card"><p class="eyebrow">AFTER-SALE COMMITMENTS</p><ul class="check-list"><li>{commitment?.warrantyMonths?`${commitment.warrantyMonths}-month warranty commitment`:"Warranty commitment not published"}</li><li>{commitment?.complimentaryServiceMonths?`${commitment.complimentaryServiceMonths}-month complimentary service`:"Service commitment not published"}</li><li>{commitment?.annualInspectionIncluded?"Annual inspection included":"Annual inspection not published"}</li><li>{commitment?.importDocumentationAvailable?"Import documentation available":"Import documentation not published"}</li></ul></div><div class="info-card"><p class="eyebrow">FOR FLEETS & BULK BUYERS</p><p>{commitment?.bulkSalesAvailable?"This dealer accepts bulk vehicle requests.":"Ask this dealer about multi-vehicle sourcing."}</p><a class="button secondary full" href="/listings/bulk">Request multiple vehicles</a></div>{dealer.googleBusinessUrl&&<a class="button ghost full" href={dealer.googleBusinessUrl} rel="noopener">View business location</a>}</aside></div></section>
</BaseLayout>
