---
import BaseLayout from "../../layouts/BaseLayout.astro"; import VehicleCard from "../../components/VehicleCard.astro"; import { getDealerBySlug, getDealerListings, getDealerReviews, getDealerStats } from "../../lib/dealer";
const dealer=Astro.params.slug?await getDealerBySlug(Astro.params.slug):null; if(!dealer) Astro.response.status=404;
let listings:any[]=[], reviews:any[]=[], stats:any={total:0,active:0,sold:0,avgRating:null,reviewCount:0}; if(dealer){[listings,reviews,stats]=await Promise.all([getDealerListings(dealer.userId,"active"),getDealerReviews(dealer.id),getDealerStats(dealer.userId)]);}
const dealerListings=listings.map((x:any)=>({...x,businessName:dealer?.businessName,dealerVerified:dealer?.isVerified}));
---
<BaseLayout title={`${dealer?.businessName||"Dealer"} — Panther`}><section class="dealer-hero"><div class="shell"><a class="back-link" href="/dealers">← Dealer network</a>{dealer?<div class="dealer-heading"><div><div class="dealer-name-row"><h1>{dealer.businessName}</h1>{dealer.isVerified&&<span class="verified">Verified business</span>}</div><p class="lead">{[dealer.city,dealer.state].filter(Boolean).join(", ")||"Nigeria"}</p></div><div class="dealer-actions">{dealer.whatsappNumber&&<a class="button primary" href={`https://wa.me/${dealer.whatsappNumber.replace(/[^0-9]/g,"")}`}>WhatsApp</a>}{dealer.contactPhone&&<a class="button secondary" href={`tel:${dealer.contactPhone}`}>Call</a>}</div></div><div class="dealer-stats"><div><b>{stats.active}</b><span>Active cars</span></div><div><b>{stats.sold}</b><span>Sold</span></div><div><b>{stats.avgRating??"—"}</b><span>{stats.reviewCount?`${stats.reviewCount} reviews`:"Reviews"}</span></div><div><b>{dealer.inspectionAvailable?"Yes":"—"}</b><span>Inspection</span></div><div><b>{dealer.deliveryAvailable?"Yes":"—"}</b><span>Delivery</span></div></div></div></section><section class="section"><div class="shell dealer-layout"><div><div class="section-head"><div><p class="eyebrow">INVENTORY</p><h2>Current vehicles</h2></div></div>{dealerListings.length?<div class="vehicle-grid">{dealerListings.map((l)=><VehicleCard listing={l}/>)}</div>:<div class="empty-state"><h3>No active inventory</h3><p>This dealer currently has no active vehicles.</p></div>}</div><aside class="dealer-sidebar"><div class="info-card"><p class="eyebrow">ABOUT</p><p>{dealer.about||"This business has not added an about section yet."}</p></div><div class="info-card"><p class="eyebrow">TRUST & SERVICE</p><ul class="check-list"><li>{dealer.isVerified?"Business identity verified":"Business identity not yet verified"}</li><li>{dealer.inspectionAvailable?"Vehicle inspection available":"Inspection not listed"}</li><li>{dealer.deliveryAvailable?"Delivery available":"Delivery not listed"}</li><li>{dealer.naddcRegistrationId?`NADDC registration: ${dealer.naddcRegistrationId}`:"NADDC registration not listed"}</li></ul></div></aside></div></section></BaseLayout>
