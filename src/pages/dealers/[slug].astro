---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleCard from "../../components/VehicleCard.astro";
import { getDealerBySlug, getDealerListings, getDealerReviews, getDealerStats, getDealerCommitment, getDealerInventoryQuality, getDealerReliability, getDealerCareEvents } from "../../lib/dealer";
import { dealerJsonLd, breadcrumbJsonLd } from "../../lib/seo";

const dealer = Astro.params.slug ? await getDealerBySlug(Astro.params.slug) : null;
if (!dealer) Astro.response.status = 404;
let listings: any[] = [];
let stats: any = { total: 0, active: 0, sold: 0, avgRating: null, reviewCount: 0 };
let commitment: any = null;
let quality: any = { averageScore: 0, listings: [] };
let reliability: any = { completedOrders: 0, trackedOrders: 0, settlementRate: null };
let care: any[] = [];
if (dealer) {
  [listings, , stats, commitment, quality, reliability, care] = await Promise.all([
    getDealerListings(dealer.userId, "active"),
    getDealerReviews(dealer.id),
    getDealerStats(dealer.userId),
    getDealerCommitment(dealer.id),
    getDealerInventoryQuality(dealer.userId),
    getDealerReliability(dealer.userId),
    getDealerCareEvents(dealer.id, 12),
  ]);
}
const schema = dealer ? { "@context": "https://schema.org", "@graph": [dealerJsonLd({ name: dealer.businessName, url: `/dealers/${dealer.slug}`, phone: dealer.contactPhone, city: dealer.city, state: dealer.state, description: dealer.about }), breadcrumbJsonLd([{ name: "Dealers", url: "/dealers" }, { name: dealer.businessName, url: `/dealers/${dealer.slug}` }])] } : undefined;
const whatsapp = dealer?.whatsappNumber ? dealer.whatsappNumber.replaceAll(" ", "").replaceAll("-", "").replaceAll("(", "").replaceAll(")", "") : "";
---
<BaseLayout title={`${dealer?.businessName ?? "Dealer"} — Panther`} description={dealer?.about || `Vehicle dealer profile for ${dealer?.businessName ?? "a Panther seller"}.`} schema={schema}>
  <section class="dealer-hero"><div class="shell"><a class="back-link" href="/dealers">← Dealer network</a>{dealer && <div class="dealer-heading"><div><div class="dealer-name-row"><h1>{dealer.businessName}</h1>{dealer.isVerified && <span class="verified">Verified business</span>}</div><p class="lead">{[dealer.city, dealer.state].filter(Boolean).join(", ") || "Nigeria"}</p></div><div class="dealer-actions">{whatsapp && <a class="button primary" href={`https://wa.me/${whatsapp}`}>WhatsApp</a>}{dealer.contactPhone && <a class="button secondary" href={`tel:${dealer.contactPhone}`}>Call</a>}</div></div>}{dealer && <div class="dealer-stats"><div><b>{stats.active}</b><span>Active cars</span></div><div><b>{stats.sold}</b><span>Sold</span></div><div><b>{stats.avgRating ?? "—"}</b><span>{stats.reviewCount ? `${stats.reviewCount} reviews` : "Reviews"}</span></div><div><b>{reliability.completedOrders}</b><span>Settled orders</span></div><div><b>{quality.averageScore}%</b><span>Inventory quality</span></div></div>}</div></section>
  {dealer ? <section class="section"><div class="shell dealer-layout"><div><div class="section-head"><p class="eyebrow">INVENTORY</p><h2>Current vehicles</h2></div>{listings.length > 0 ? <div class="vehicle-grid">{listings.map((listing: any) => <VehicleCard listing={listing} />)}</div> : <div class="empty-state"><h3>No active inventory</h3><p>This dealer currently has no active vehicles published on Panther.</p></div>}{care.length > 0 && <div class="info-card"><p class="eyebrow">VEHICLE CARE & RECORDS</p>{care.map((event: any) => <div class="ops-row"><div><b>{event.title}</b><span>{new Date(event.eventDate).toLocaleDateString("en-NG")} · {event.type.replaceAll("_", " ")}</span>{event.provider && <small>{event.provider}{event.location ? ` · ${event.location}` : ""}</small>}</div><div>{event.mileageKm != null && <span>{new Intl.NumberFormat("en-NG").format(Number(event.mileageKm))} km</span>}{event.nextDueAt && <small>Next due {new Date(event.nextDueAt).toLocaleDateString("en-NG")}</small>}</div></div>)}</div>}</div><aside class="dealer-sidebar"><div class="info-card"><p class="eyebrow">WHAT PANTHER VERIFIED</p><ul class="check-list"><li>{dealer.isVerified ? "Business identity verified" : "Business identity not yet verified"}</li><li>{dealer.naddcRegistrationId ? `NADDC registration: ${dealer.naddcRegistrationId}` : "NADDC registration not listed"}</li><li>{dealer.inspectionAvailable ? "Vehicle inspection available" : "Inspection not listed"}</li><li>{dealer.deliveryAvailable ? "Delivery available" : "Delivery not listed"}</li></ul></div><div class="info-card"><p class="eyebrow">AFTER-SALE COMMITMENTS</p><ul class="check-list"><li>{commitment?.warrantyMonths ? `${commitment.warrantyMonths}-month warranty commitment` : "Warranty commitment not published"}</li><li>{commitment?.complimentaryServiceMonths ? `${commitment.complimentaryServiceMonths}-month complimentary service` : "Service commitment not published"}</li><li>{commitment?.annualInspectionIncluded ? "Annual inspection included" : "Annual inspection not published"}</li><li>{commitment?.importDocumentationAvailable ? "Import documentation available" : "Import documentation not published"}</li></ul></div><div class="info-card"><p class="eyebrow">FOR FLEETS & BULK BUYERS</p><p>{commitment?.bulkSalesAvailable ? "This dealer accepts bulk vehicle requests." : "Ask this dealer about multi-vehicle sourcing."}</p><a class="button secondary full" href="/listings/bulk">Request multiple vehicles</a></div>{dealer.googleBusinessUrl && <div class="info-card"><a class="button ghost full" href={dealer.googleBusinessUrl} rel="noopener noreferrer">View business location</a></div>}</aside></div></section> : <section class="section"><div class="shell empty-state"><h1>Dealer not found</h1><p>This dealer profile is unavailable or no longer public.</p><a class="button secondary" href="/dealers">Back to dealer network</a></div></section>}
</BaseLayout>
