---
import BaseLayout from "../../layouts/BaseLayout.astro";
import styles from "./index.module.css";
import "@/styles/global.css";
import { getDomains, getCategoriesByDomain, getMakesByCategory } from "@/lib/gvo";

const domains = await getDomains();
const carDomain = domains.find((d) => d.slug === "car") ?? domains[0];
const categories = carDomain ? await getCategoriesByDomain(carDomain.id) : [];

const allMakes: Array<{ name: string; slug: string; domainSlug: string }> = [];
for (const cat of categories) {
  const makes = await getMakesByCategory(cat.id);
  for (const m of makes) {
    allMakes.push({ name: m.name, slug: m.slug, domainSlug: carDomain!.slug });
  }
}
allMakes.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Vehicle Import Pricing"
  posture="walking"
  description="Calculate the landed cost of any vehicle imported into Nigeria. Full 13-step statutory breakdown with live NCS rates."
  ogUrl="https://panther.ng/pricing"
>
  <section class={styles.hero}>
    <h1 class={`${styles.heroTitle} font-sans`}>
      What does it cost to import a vehicle into Nigeria?
    </h1>
    <p class={styles.heroSubtitle}>
      Not the figure your agent quoted. The statutory breakdown, naira for naira, from FOB to your port.
    </p>
  </section>

  <section class={styles.explainer}>
    <div class={styles.containerEyes}>
      <h2 class={styles.explainerTitle}>The 13-Step Formula</h2>
      <p class={styles.explainerIntro}>
        Every landed cost is computed by applying Nigeria's statutory import charges
        in the exact order of operations. No approximations, no skipped charges.
      </p>
      <div class={styles.stepsGrid}>
        {[
          { num: "1", name: "FOB", desc: "Cohort wholesale value (USD)" },
          { num: "2", name: "CIF", desc: "+ Freight + Insurance" },
          { num: "3", name: "Naira Conversion", desc: "× Live NCS customs rate" },
          { num: "4", name: "Import Duty", desc: "20% × CIF (₦)" },
          { num: "5", name: "NAC Levy", desc: "5% × CIF (₦)" },
          { num: "6", name: "Surcharge", desc: "7% × Import Duty" },
          { num: "7", name: "CISS", desc: "1% × FOB (₦)" },
          { num: "8", name: "ETLS", desc: "0.5% × CIF (₦)" },
          { num: "9", name: "VAT Base", desc: "CIF + Duty + NAC + Surcharge + CISS + ETLS" },
          { num: "10", name: "VAT", desc: "7.5% × VAT Base" },
          { num: "11", name: "Total Statutory", desc: "Sum of Steps 4–10" },
          { num: "12", name: "Non-Statutory", desc: "THC + Agent + Release + Docs" },
          { num: "13", name: "Landed Cost", desc: "Floor → Ceiling range", final: true },
        ].map((step) => (
          <div class={`${styles.stepCard} ${step.final ? styles.stepFinal : ""}`}>
            <span class={styles.stepNum}>{step.num}</span>
            <span class={styles.stepName}>{step.name}</span>
            <span class={styles.stepDesc}>{step.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class={styles.selector}>
    <h2 class={styles.selectorTitle}>Select a Make</h2>
    <p class={styles.selectorSubtitle}>
      Pick a manufacturer to see pricing by model and trim.
    </p>
    <div class={styles.makesGrid}>
      {allMakes.map((m) => (
        <a href={`/vehicles/${m.domainSlug}/${m.slug}`} class={styles.makeCard}>
          <span class={styles.makeName}>{m.name}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
