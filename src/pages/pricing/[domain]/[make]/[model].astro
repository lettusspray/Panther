---
import BaseLayout from "@/layouts/BaseLayout.astro";
import styles from "./[model].module.css";
import "@/styles/global.css";
import { resolveModelPageData } from "@/lib/gvo";

const { domain, make, model } = Astro.params;

if (!domain || !make || !model) {
  return Astro.redirect("/pricing", 302);
}

const modelPage = await resolveModelPageData(domain, make, model);

const displayMake = make.replace(/-/g, " ");
const displayModel = model.replace(/-/g, " ");

const title = modelPage
  ? `${displayMake} ${displayModel} Landed Cost in Nigeria — Trims and Pricing`
  : "Vehicle Not Found";

const description = modelPage
  ? `Landed cost breakdown for ${displayMake} ${displayModel} (${modelPage.modelYearRange || "various years"}) imported into Nigeria. Browse trims with full 13-step statutory pricing.`
  : `Landed cost information for ${displayMake} ${displayModel} in Nigeria.`;

const faqSchema = modelPage ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the landed cost of a ${displayMake} ${displayModel} in Nigeria?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The landed cost of a ${displayMake} ${displayModel} in Nigeria varies by trim level, model year, and import conditions. Each trim has a full 13-step statutory breakdown including import duty (20%), NAC levy (5%), CISS, ETLS, VAT (7.5%), and non-statutory port fees. Browse the trims below for exact pricing based on current NCS exchange rates.`,
      },
    },
    {
      "@type": "Question",
      "name": `How many ${displayMake} ${displayModel} trims are available?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": modelPage.trims.length > 0
          ? `There are ${modelPage.trims.length} ${displayMake} ${displayModel} trims available with pricing data. Each trim includes cohort-level FOB pricing and a full landed-cost breakdown.${modelPage.modelYearRange ? ` Model years range from ${modelPage.modelYearRange}.` : ""}`
          : `Pricing data for ${displayMake} ${displayModel} trims is being added. Check back soon.`,
      },
    },
  ],
} : null;
---

<BaseLayout title={title} posture="walking" description={description} jsonLd={faqSchema ? [faqSchema] : undefined} ogUrl={`https://panther.ng/pricing/${domain}/${make}/${model}`}>
{
  modelPage ? (
    <>
      <section class={styles.hero}>
        <div class={styles.containerWalking}>
          <nav class={styles.breadcrumb}>
            <a href="/pricing">Pricing</a>
            <span class={styles.breadcrumbSep}>/</span>
            <a href={`/pricing/${domain}`}>{domain.replace(/-/g, " ")}</a>
            <span class={styles.breadcrumbSep}>/</span>
            <a href={`/pricing/${domain}/${make}`}>{displayMake}</a>
            <span class={styles.breadcrumbSep}>/</span>
            <span class={styles.breadcrumbCurrent}>{displayModel}</span>
          </nav>
          <h1 class={styles.heroTitle}>
            What is the landed cost of a {displayMake} {displayModel} in Nigeria?
          </h1>
          <p class={styles.heroSubtitle}>
            The landed cost varies by trim level, model year, and import variables.
            Each trim below includes a full 13-step statutory breakdown computed from live NCS rates.
            {modelPage.modelYearRange ? ` Available model years: ${modelPage.modelYearRange}.` : ""}
          </p>
        </div>
      </section>

      <section class={styles.modelsSection}>
        <div class={styles.containerWalking}>
          {modelPage.trims.length > 0 ? (
            <div class={styles.trimsGrid}>
              {modelPage.trims.map((trim) => (
                <a
                  href={`/pricing/${domain}/${make}/${model}/${trim.slug}`}
                  class={styles.trimCard}
                >
                  <div class={styles.trimName}>{trim.name}</div>
                  {trim.engine ? <div class={styles.trimDetail}>{trim.engine}</div> : null}
                  {trim.transmission ? <div class={styles.trimDetail}>{trim.transmission}</div> : null}
                </a>
              ))}
            </div>
          ) : (
            <p class={styles.emptyState}>No trims available for this model yet. Check back soon.</p>
          )}
        </div>
      </section>
    </>
  ) : (
    <section class={styles.hero}>
      <div class={styles.containerWalking}>
        <nav class={styles.breadcrumb}>
          <a href="/pricing">Pricing</a>
          <span class={styles.breadcrumbSep}>/</span>
          <a href={`/pricing/${domain}`}>{displayMake}</a>
        </nav>
        <h1 class={styles.heroTitle}>Vehicle not found</h1>
        <p class={styles.heroSubtitle}>
          We could not find {displayMake} {displayModel} in our vehicle database.
          Try browsing <a href="/pricing" style="color: var(--panther-roaring-hex); text-decoration: underline;">all makes</a>.
        </p>
      </div>
    </section>
  )
}
</BaseLayout>
