---
import BaseLayout from "../layouts/BaseLayout.astro";
import VehicleCard from "../components/VehicleCard.astro";
import { getMarketplaceListings } from "../lib/marketplace";
let listings:any[]=[];
try { listings = await getMarketplaceListings({limit:8}); } catch (e) { console.error(e); }
---
<BaseLayout title="Panther — Buy, sell and source cars in Nigeria">
<section class="hero"><div class="shell hero-grid"><div class="hero-copy"><p class="eyebrow">THE VEHICLE MARKETPLACE FOR NIGERIA</p><h1>Buy the right car. Know what you're buying.</h1><p class="hero-lead">Panther brings vehicle data, real inventory, seller trust and structured buying into one place — whether the car is already in Nigeria or coming from abroad.</p><form class="search-panel" action="/listings"><label for="q">What are you looking for?</label><div class="search-row"><input id="q" name="q" placeholder="Toyota Camry, Lexus RX, 2022 Prado…" /><button type="submit">Search cars</button></div><div class="quick-links"><a href="/listings?make=Toyota">Toyota</a><a href="/listings?make=Lexus">Lexus</a><a href="/listings?make=Mercedes-Benz">Mercedes-Benz</a><a href="/listings?make=Honda">Honda</a></div></form></div><div class="hero-visual"><img src="/car-placeholder.svg" alt="Panther vehicle marketplace" /></div></div></section>
<section class="trust-strip"><div class="shell trust-grid"><div><strong>Real vehicle information</strong><span>Specs, ownership context and condition — not just an advert.</span></div><div><strong>Seller trust</strong><span>Verification, reviews and visible business details.</span></div><div><strong>Safer buying</strong><span>Structured payment and settlement flows are built around the transaction.</span></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><div><p class="eyebrow">MARKETPLACE</p><h2>Cars available now</h2><p class="muted">Start with vehicles that can actually be bought, then compare the details.</p></div><a class="text-link" href="/listings">View all cars →</a></div>{listings.length ? <div class="vehicle-grid">{listings.map((listing)=><VehicleCard listing={listing}/>)}</div> : <div class="empty-state"><h3>Inventory is being refreshed.</h3><p>Browse the catalog or check back shortly for active listings.</p><a class="button secondary" href="/vehicles">Browse vehicle catalog</a></div>}</div></section>
<section class="section section-muted"><div class="shell feature-grid"><div><p class="eyebrow">BUYING FROM ABROAD</p><h2>One destination for local and imported cars.</h2><p class="muted">Panther is designed for purchases from Nigerian sellers as well as sourcing from Japan, China, the US, Europe and other markets. The transaction model is being built around the whole order, not a single seller's checkout.</p><a class="button primary" href="/listings">Explore the marketplace</a></div><div class="feature-list"><div><b>01</b><span>Find the exact vehicle or ask for a source.</span></div><div><b>02</b><span>Compare price, condition, seller and vehicle evidence.</span></div><div><b>03</b><span>Pay through a structured transaction and track what happens next.</span></div></div></div></section>
</BaseLayout>
