---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import "@/styles/global.css";
import styles from "./index.module.css";
import { db } from "@/lib/db";
import { gvoDomain, gvoCategory, gvoMake, gvoModel } from "@/lib/db/schema";
import { eq } from "drizzle-orm";
import { getRequiredConfig } from "@/lib/config";

// Live statutory rates from system_config — never hardcoded figures.
let rates: Record<string, string> | null = null;
try {
  const [surcharge, nac, ciss, duty, vat] = await Promise.all([
    getRequiredConfig("surcharge_rate"),
    getRequiredConfig("nac_levy_rate"),
    getRequiredConfig("ciss_rate"),
    getRequiredConfig("import_duty_rate"),
    getRequiredConfig("vat_rate"),
  ]);
  rates = {
    surcharge: String(Number(surcharge.value) * 100),
    nac: String(Number(nac.value) * 100),
    ciss: String(Number(ciss.value) * 100),
    duty: String(Number(duty.value) * 100),
    vat: String(Number(vat.value) * 100),
  };
} catch {
  // Rates unavailable — the step cards render without numbers rather than lying.
}

// Example vehicle for the CTA — resolved from the DB, never a hardcoded model.
let exampleUrl = "/pricing";
let exampleLabel = "What's a vehicle worth?";
try {
  const [sample] = await db
    .select({ makeSlug: gvoMake.slug, makeName: gvoMake.name, modelSlug: gvoModel.slug, modelName: gvoModel.name })
    .from(gvoModel)
    .innerJoin(gvoMake, eq(gvoModel.makeId, gvoMake.id))
    .innerJoin(gvoCategory, eq(gvoMake.categoryId, gvoCategory.id))
    .innerJoin(gvoDomain, eq(gvoCategory.domainId, gvoDomain.id))
    .where(eq(gvoDomain.slug, "car"))
    .limit(1);
  if (sample) {
    exampleUrl = `/pricing/car/${sample.makeSlug}/${sample.modelSlug}`;
    exampleLabel = `What's a ${sample.makeName} ${sample.modelName} worth?`;
  }
} catch {
  // DB unavailable — fall back to the pricing hub.
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the landed cost of a 2015 Toyota Camry in Nigeria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The landed cost of a 2015 Toyota Camry in Nigeria depends on trim, model year, and port of entry. Panther computes it from the 13-step statutory breakdown — FOB anchor, CIF, NCS naira conversion, import duty, NAC levy, surcharge, CISS, ETLS, VAT, and non-statutory port charges — using live NCS exchange rates. When those rates go stale, the engine halts rather than publish an outdated figure."
      }
    }
  ]
};
---

<BaseLayout title="Panther — Nigeria's Auto Marketplace" posture="roaring" theme="dark" jsonLd={[faqSchema]} ogUrl="https://panther.ng">
  <section class={styles.hero}>
    <h1 class={styles.heroTitle}>
      We don't sell cars.<br />
      We reveal the truth about them.
    </h1>
    <p class={styles.heroSubtitle}>
      Panther is the Nigerian auto marketplace. Escrow holds the money until you confirm
      the vehicle, condition reports tell you what you're buying, and the landed cost is
      published in full.
    </p>
    <div class={styles.heroBadges}>
      <span class={styles.heroBadge}>
        <span class={styles.badgeDot}></span>
        Escrow held
      </span>
      <span class={styles.heroBadge}>
        Condition reports
      </span>
      <span class={styles.heroBadge}>
        No cancel fees
      </span>
    </div>
    <div class={styles.heroActions}>
      <Button label="Browse Listings" href="/listings" variant="primary" size="lg" />
      <Button label="Sell a Vehicle" href="/listings/new" variant="secondary" size="lg" />
    </div>
  </section>

  <section class={styles.valueProps}>
    <div class={styles.propsGrid}>
      <div class={styles.propCard}>
        <h3 class={styles.propTitle}>Switchboard</h3>
        <p class={styles.propText}>
          The buyer's money sits in escrow until both sides confirm the vehicle matches
          its listing. No cancellation fee, ever.
        </p>
        <a href="/switchboard" class={styles.propCta}>How escrow works</a>
      </div>
      <div class={styles.propCard}>
        <h3 class={styles.propTitle}>Condition reports</h3>
        <p class={styles.propText}>
          Every listing carries a structured condition report, category by category.
          Cars, motorcycles, and commercial vehicles each have their own checks. Free,
          no paywall.
        </p>
        <a href="/vehicles" class={styles.propCta}>Browse the catalog</a>
      </div>
      <div class={styles.propCard}>
        <h3 class={styles.propTitle}>Landed cost</h3>
        <p class={styles.propText}>
          The full 13-step statutory breakdown for any vehicle imported into Nigeria.
          FOB to CIF to duty to VAT, every charge itemised.
        </p>
        <a href="/pricing" class={styles.propCta}>See the method</a>
      </div>
    </div>
  </section>

  <section class={styles.showWork}>
    <h2 class={styles.sectionTitle}>Where the price comes from</h2>
    <p class={styles.sectionSubtitle}>
      Import duty, NAC levy, surcharge, CISS, ETLS, VAT.
      Computed from live statutory rates, in the right order.
    </p>
    <div class={styles.formulaGrid}>
      <div class={`${styles.stepCard} ${styles.stepCardHighlight}`}>
        <div class={styles.stepNumber}>Step 3</div>
        <div class={styles.stepTitle}>Naira conversion</div>
        <div class={styles.stepDesc}>CIF × NCS customs rate. Pulled live, not guessed.</div>
      </div>
      <div class={`${styles.stepCard} ${styles.stepCardHighlight}`}>
        <div class={styles.stepNumber}>Step 6</div>
        <div class={styles.stepTitle}>Surcharge</div>
        <div class={styles.stepDesc}>{rates ? `${rates.surcharge}% of Import Duty` : "Percentage of Import Duty"}. Not on CIF — the most common miscalculation in the formula.</div>
      </div>
      <div class={`${styles.stepCard} ${styles.stepCardHighlight}`}>
        <div class={styles.stepNumber}>Step 5</div>
        <div class={styles.stepTitle}>NAC levy</div>
        <div class={styles.stepDesc}>{rates ? `${rates.nac}% of CIF for used vehicles` : "Levy on CIF for used vehicles"}. Set from live NCS policy.</div>
      </div>
      <div class={`${styles.stepCard} ${styles.stepCardHighlight}`}>
        <div class={styles.stepNumber}>Step 7</div>
        <div class={styles.stepTitle}>CISS / FCS</div>
        <div class={styles.stepDesc}>{rates ? `${rates.ciss}% of FOB in Naira` : "Percentage of FOB in Naira"}. Configured from live NCS enforcement data.</div>
      </div>
    </div>
    <div class={styles.freshnessBanner}>
      <strong>Data freshness:</strong> If NCS or CBN rates go stale, the engine halts.
      "Live market data temporarily unavailable."
    </div>
  </section>

  <section class={styles.trustSection}>
    <div class={styles.trustGrid}>
      <div class={styles.trustItem}>
        <div class={styles.trustLabel}>Live rates</div>
        <div class={styles.trustDesc}>NCS and CBN rates pulled fresh. If stale, the engine halts.</div>
      </div>
      <div class={styles.trustItem}>
        <div class={styles.trustLabel}>Nationwide</div>
        <div class={styles.trustDesc}>No city is the default. Prices and parts data are national, not Lagos-centric.</div>
      </div>
      <div class={styles.trustItem}>
        <div class={styles.trustLabel}>No cancel fees</div>
        <div class={styles.trustDesc}>Neither party pays if the deal falls through.</div>
      </div>
    </div>
  </section>

  <section class={styles.ctaSection}>
    <h2 class={styles.ctaTitle}>
      Found one?
    </h2>
    <p class={styles.ctaText}>
      When a listing matches, Switchboard holds the payment until the vehicle checks out.
    </p>
    <div class={styles.ctaActions}>
      <Button label="Browse Listings" href="/listings" variant="primary" size="lg" />
      <Button label={exampleLabel} href={exampleUrl} variant="tertiary" size="lg" />
    </div>
  </section>
</BaseLayout>
