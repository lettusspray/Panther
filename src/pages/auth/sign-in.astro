---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Sign in — Panther"><section class="auth-wrap"><div class="auth-card"><p class="eyebrow">PANTHER ACCOUNT</p><h1>Sign in</h1><p class="muted">Use your Panther account to buy, sell and manage transactions.</p><form id="signin-form"><label>Email<input id="email" type="email" autocomplete="email" required /></label><label>Password<input id="password" type="password" autocomplete="current-password" required /></label><button class="button primary full" type="submit">Sign in</button><p id="error" class="fine-print" role="alert"></p></form><p class="fine-print">Don't have an account? <a href="/auth/sign-up">Create one</a>.</p></div></section><script>import { authClient } from "../../lib/auth/client"; const form=document.querySelector<HTMLFormElement>("#signin-form"); const error=document.querySelector<HTMLElement>("#error"); form?.addEventListener("submit",async(e)=>{e.preventDefault(); if(error) error.textContent=""; const result=await authClient.signIn.email({email:(document.querySelector<HTMLInputElement>("#email")!).value,password:(document.querySelector<HTMLInputElement>("#password")!).value}); if(result.error){if(error) error.textContent=result.error.message||"Unable to sign in."; return;} window.location.href="/dashboard";});</script></BaseLayout>
