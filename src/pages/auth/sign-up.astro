---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import "@/styles/global.css";
---

<BaseLayout title="Create Account" posture="walking" ogUrl="https://panther.ng/auth/sign-up">
  <section class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">Join Panther</h1>
      <p class="auth-subtitle">Create your account to start buying and selling</p>

      <form id="sign-up-form" class="auth-form">
        <div class="form-row">
          <div class="form-group">
            <label for="name" class="form-label">Full Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="form-input"
              placeholder="Your name"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="form-input"
            placeholder="you@example.com"
          />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength={8}
            autocomplete="new-password"
            class="form-input"
            placeholder="At least 8 characters"
          />
        </div>

        <div id="error-message" class="form-error" hidden></div>

        <Button label="Create Account" type="submit" variant="primary" full />
      </form>

      <p class="auth-alt">
        Already have an account? <a href="/auth/sign-in" id="sign-in-link">Sign in</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 128px);
    padding: var(--space-6) var(--space-4);
  }

  .auth-card {
    width: 100%;
    max-width: 400px;
    padding: var(--space-8);
    border: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 20%, transparent);
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  .auth-title {
    font-family: var(--posture-font);
    font-size: 28px;
    color: var(--panther-resting-hex);
    margin-bottom: var(--space-1);
  }

  .auth-subtitle {
    font-size: 14px;
    color: var(--panther-eyes-hex);
    margin-bottom: var(--space-8);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: flex;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .form-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--panther-resting-hex);
  }

  .form-input {
    padding: var(--space-3) var(--space-3);
    border: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 30%, transparent);
    border-radius: 8px;
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--panther-resting-hex);
    background: #fff;
    transition: border-color 200ms ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--panther-roaring-hex);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--panther-roaring-hex) 15%, transparent);
  }

  .form-input::placeholder {
    color: var(--panther-eyes-hex);
  }

  .form-error {
    padding: var(--space-3);
    background: color-mix(in oklch, var(--panther-danger-strong-hex) 8%, #fff);
    border: 1px solid color-mix(in oklch, var(--panther-danger-strong-hex) 30%, transparent);
    border-radius: 8px;
    font-size: 13px;
    color: var(--panther-danger-strong-hex);
  }

  .auth-alt {
    text-align: center;
    font-size: 14px;
    color: var(--panther-eyes-hex);
    margin-top: var(--space-6);
  }

  .auth-alt a {
    color: var(--panther-roaring-hex);
    font-weight: 500;
  }

  .auth-alt a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const form = document.getElementById("sign-up-form") as HTMLFormElement;
  const errorEl = document.getElementById("error-message") as HTMLDivElement;
  const signInLink = document.getElementById("sign-in-link") as HTMLAnchorElement;

  const params = new URLSearchParams(window.location.search);
  const returnTo = params.get("returnTo");

  // Preserve returnTo when linking to sign-in
  if (signInLink && returnTo) {
    signInLink.href = `/auth/sign-in?returnTo=${encodeURIComponent(returnTo)}`;
  }

  function getReturnUrl(): string {
    if (returnTo && returnTo.startsWith("/") && !returnTo.startsWith("//")) {
      return decodeURIComponent(returnTo);
    }
    return "/";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const name = (document.getElementById("name") as HTMLInputElement).value;
    const email = (document.getElementById("email") as HTMLInputElement).value;
    const password = (document.getElementById("password") as HTMLInputElement).value;

    try {
      const res = await fetch("/api/auth/sign-up/email", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password }),
      });

      const data = (await res.json()) as { error?: { message?: string } };

      if (!res.ok || data.error) {
        errorEl.textContent = data.error?.message ?? "Could not create account";
        errorEl.hidden = false;
        return;
      }

      window.location.href = getReturnUrl();
    } catch {
      errorEl.textContent = "Something went wrong. Please try again.";
      errorEl.hidden = false;
    }
  });
</script>
