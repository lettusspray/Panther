---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Create account — Panther"><section class="auth-wrap"><div class="auth-card"><p class="eyebrow">PANTHER ACCOUNT</p><h1>Create your account</h1><form id="signup-form"><label>Name<input id="name" autocomplete="name" required /></label><label>Email<input id="email" type="email" autocomplete="email" required /></label><label>Password<input id="password" type="password" autocomplete="new-password" minlength="8" required /></label><button class="button primary full" type="submit">Create account</button><p id="error" class="fine-print" role="alert"></p></form><p class="fine-print">Already have an account? <a href="/auth/sign-in">Sign in</a>.</p></div></section><script>import { authClient } from "../../lib/auth/client"; const form=document.querySelector<HTMLFormElement>("#signup-form"); const error=document.querySelector<HTMLElement>("#error"); form?.addEventListener("submit",async(e)=>{e.preventDefault(); if(error) error.textContent=""; const result=await authClient.signUp.email({name:(document.querySelector<HTMLInputElement>("#name")!).value,email:(document.querySelector<HTMLInputElement>("#email")!).value,password:(document.querySelector<HTMLInputElement>("#password")!).value}); if(result.error){if(error) error.textContent=result.error.message||"Unable to create account."; return;} window.location.href="/dashboard";});</script></BaseLayout>
