---
import BaseLayout from "../../layouts/BaseLayout.astro";
import styles from "./profile.module.css";
import "@/styles/global.css";
import { getDealerByUserId } from "../../lib/dealer";

const user = Astro.locals.user;
if (!user?.id) return Astro.redirect("/auth/sign-in");

const profile = await getDealerByUserId(user.id as string);
const formMethod = profile ? "PATCH" : "POST";
---

<BaseLayout title="Storefront Profile" posture="walking" ogUrl="https://panther.ng/dashboard/profile">
  <div class={styles.page}>
    <div class={styles.container}>
      <div class={styles.header}>
        <h1 class={styles.title}>Storefront Profile</h1>
        <p class={styles.subtitle}>
          {profile
            ? "Edit your storefront"
            : "Set up your dealer storefront"}
        </p>
      </div>

      {profile && (
        <a href={`/dealers/${profile.slug}`} class={styles.previewLink}>
          Preview your storefront →
        </a>
      )}

      {/* Google Business Profile Guide */}
      <div class={styles.gbpGuide}>
        <h2 class={styles.gbpTitle}>Get found on Google Maps & Search</h2>
        <p class={styles.gbpText}>
          A <strong>Google Business Profile</strong> is the single highest-ROI thing you can do for your dealership.
          It's <strong>free</strong>, takes <strong>15 minutes</strong> to set up, and makes your business appear
          when buyers search for vehicles in your area. Dealers with a complete GBP get <strong>5× more leads</strong>
          from local search.
        </p>
        <p class={styles.gbpText}>
          As a Panther dealer, you get a <strong>free website</strong> — just set your custom subdomain below
          and submit it on your Google Business Profile. Your customers will see your dealership on a
          <strong> professional, SEO-optimized site</strong> at <code>yourbusiness.panther.ng</code>.
          No hosting fees, no setup, no maintenance.
        </p>
        <ol class={styles.gbpSteps}>
          <li>Go to <a href="https://business.google.com" target="_blank" rel="noopener noreferrer">business.google.com</a> and claim your profile</li>
          <li>Choose your subdomain below (e.g. <code>lagos-motors.panther.ng</code>)</li>
          <li>In your GBP dashboard, add your subdomain URL as your website</li>
          <li>You're live on Google Maps — buyers find you, message you, and transact securely on Panther</li>
        </ol>
        <p class={styles.gbpTip}>
          <strong>Pro tip:</strong> Add photos, respond to reviews, and post weekly to rank higher.
        </p>
      </div>

      <form id="profile-form" data-method={formMethod} class={styles.form}>
        <div class={styles.field}>
          <label class={styles.label} for="businessName">Business Name *</label>
          <input
            class={styles.input}
            id="businessName"
            name="businessName"
            type="text"
            required
            value={profile?.businessName ?? ""}
            placeholder="e.g. Lagos Motors Ltd"
          />
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="slug">Storefront URL *</label>
          <div class={styles.urlPreview}>
            <span class={styles.urlPrefix}>panther.ng/dealers/</span>
            <input
              class={`${styles.input} ${styles.inputSlug}`}
              id="slug"
              name="slug"
              type="text"
              required
              pattern="^[a-z0-9-]+$"
              value={profile?.slug ?? ""}
              placeholder="lagos-motors-ltd"
            />
          </div>
          <span class={styles.hint}>Lowercase letters, numbers, and hyphens only</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="subdomain">Your Free Subdomain (optional)</label>
          <div class={styles.urlPreview}>
            <input
              class={`${styles.input} ${styles.inputSlug}`}
              id="subdomain"
              name="subdomain"
              type="text"
              pattern="^[a-z0-9-]+$"
              value={profile?.subdomain ?? ""}
              placeholder="your-business-name"
            />
            <span class={styles.urlSuffix}>.panther.ng</span>
          </div>
          <span class={styles.hint}>
            {profile?.subdomain
              ? `Your dealer website: https://${profile.subdomain}.panther.ng`
              : "Set a custom subdomain for your free Panther website. Lowercase letters, numbers, and hyphens."}
          </span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="about">About</label>
          <textarea
            class={styles.textarea}
            id="about"
            name="about"
            rows={4}
            placeholder="Tell buyers about your business..."
          >{profile?.about ?? ""}</textarea>
        </div>

        <div class={styles.row}>
          <div class={styles.field}>
            <label class={styles.label} for="city">City</label>
            <input
              class={styles.input}
              id="city"
              name="city"
              type="text"
              value={profile?.city ?? ""}
              placeholder="e.g. Lagos"
            />
          </div>
          <div class={styles.field}>
            <label class={styles.label} for="state">State</label>
            <input
              class={styles.input}
              id="state"
              name="state"
              type="text"
              value={profile?.state ?? ""}
              placeholder="e.g. Lagos"
            />
          </div>
        </div>

        <div class={styles.row}>
          <div class={styles.field}>
            <label class={styles.label} for="contactPhone">Phone Number</label>
            <input
              class={styles.input}
              id="contactPhone"
              name="contactPhone"
              type="tel"
              value={profile?.contactPhone ?? ""}
              placeholder="e.g. 08031234567"
            />
          </div>
          <div class={styles.field}>
            <label class={styles.label} for="whatsappNumber">WhatsApp Number</label>
            <input
              class={styles.input}
              id="whatsappNumber"
              name="whatsappNumber"
              type="tel"
              value={profile?.whatsappNumber ?? ""}
              placeholder="e.g. 2348031234567"
            />
          </div>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="googleBusinessUrl">Google Business Profile URL</label>
          <input
            class={styles.input}
            id="googleBusinessUrl"
            name="googleBusinessUrl"
            type="url"
            value={profile?.googleBusinessUrl ?? ""}
            placeholder="https://business.google.com/..."
          />
          <span class={styles.hint}>Submit your <code>{profile?.subdomain ? `https://${profile.subdomain}.panther.ng` : "subdomain.panther.ng"}</code> URL here after claiming your profile</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="naddcRegistrationId">NADDC Registration ID</label>
          <input
            class={styles.input}
            id="naddcRegistrationId"
            name="naddcRegistrationId"
            type="text"
            value={profile?.naddcRegistrationId ?? ""}
            placeholder="e.g. NADDC/2026/12345"
          />
          <span class={styles.hint}>Required for verified status. Register at naddc.gov.ng</span>
        </div>

        <div class={styles.checkRow}>
          <label class={styles.checkLabel}>
            <input
              type="checkbox"
              name="inspectionAvailable"
              id="inspectionAvailable"
              checked={profile?.inspectionAvailable ?? false}
            />
            <span>I offer physical vehicle inspections</span>
          </label>
        </div>

        <div class={styles.checkRow}>
          <label class={styles.checkLabel}>
            <input
              type="checkbox"
              name="deliveryAvailable"
              id="deliveryAvailable"
              checked={profile?.deliveryAvailable ?? false}
            />
            <span>I offer vehicle delivery</span>
          </label>
        </div>

        <div class={styles.formActions}>
          <button type="submit" class="btn btn-primary btn-md">
            <span class="btn-label">{profile ? "Save Changes" : "Create Storefront"}</span>
          </button>
          {profile && (
            <button type="button" id="delete-btn" class="btn btn-danger btn-md">
              Delete Storefront
            </button>
          )}
        </div>

        <div id="form-status" class={styles.formStatus} style="display: none;"></div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("profile-form") as HTMLFormElement;
  const statusEl = document.getElementById("form-status") as HTMLElement;
  const method = form?.dataset.method ?? "POST";

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const body: Record<string, unknown> = {};
    data.forEach((value, key) => {
      if (key === "inspectionAvailable" || key === "deliveryAvailable") {
        body[key] = !!data.get(key);
      } else {
        body[key] = value;
      }
    });

    statusEl.style.display = "none";
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const setBtnLabel = (text: string) => {
      const labelEl = submitBtn.querySelector(".btn-label");
      if (labelEl) labelEl.textContent = text;
    };
    submitBtn.disabled = true;
    submitBtn.classList.add("is-loading");
    setBtnLabel("Saving...");

    try {
      const res = await fetch("/api/dealers", {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const result: Record<string, unknown> = await res.json();
      if (res.ok) {
        statusEl.textContent = "Saved! Redirecting...";
        statusEl.style.display = "block";
        statusEl.style.color = "oklch(45% 0.18 150)";
        setTimeout(() => (window.location.href = "/dashboard"), 1000);
      } else {
        statusEl.textContent = (result.error as string) ?? "Failed to save";
        statusEl.style.display = "block";
        statusEl.style.color = "oklch(45% 0.18 30)";
        submitBtn.classList.remove("is-loading");
        submitBtn.disabled = false;
        setBtnLabel(method === "PATCH" ? "Save Changes" : "Create Storefront");
      }
    } catch {
      statusEl.textContent = "Network error. Please try again.";
      statusEl.style.display = "block";
      statusEl.style.color = "oklch(45% 0.18 30)";
      submitBtn.classList.remove("is-loading");
      submitBtn.disabled = false;
      setBtnLabel("Save Changes");
    }
  });
</script>
