---
import BaseLayout from "../../layouts/BaseLayout.astro";
import styles from "./index.module.css";
import "@/styles/global.css";
import { db } from "../../lib/db";
import { listing, gvoTrim, gvoModel, gvoMake, user } from "../../lib/db/schema";
import { eq, desc } from "drizzle-orm";
import { checkDataFreshness, PRICING_RATE_KEYS } from "../../lib/config";

const listings = await db
  .select({
    id: listing.id,
    modelYear: listing.modelYear,
    mileageKm: listing.mileageKm,
    askingPriceNgn: listing.askingPriceNgn,
    status: listing.status,
    createdAt: listing.createdAt,
    trimName: gvoTrim.name,
    modelName: gvoModel.name,
    makeName: gvoMake.name,
    makeId: gvoMake.id,
    sellerName: user.name,
  })
  .from(listing)
  .innerJoin(gvoTrim, eq(listing.trimId, gvoTrim.id))
  .innerJoin(gvoModel, eq(gvoTrim.modelId, gvoModel.id))
  .innerJoin(gvoMake, eq(gvoModel.makeId, gvoMake.id))
  .innerJoin(user, eq(listing.sellerId, user.id))
  .where(eq(listing.status, "active"))
  .orderBy(desc(listing.createdAt))
  .limit(50);

const makes = [...new Set(listings.map((l) => l.makeName))].sort();

const freshness = await checkDataFreshness(PRICING_RATE_KEYS);
---

<BaseLayout
  title="Vehicle Listings"
  posture="walking"
  description="Browse active vehicle listings on Panther. Structured condition reports, clear asking prices."
  ogUrl="https://panther.ng/listings"
>
  {!freshness.ok && (
    <div class={styles.freshnessBanner}>
      Live market data temporarily unavailable. Prices shown may not reflect current statutory rates.
    </div>
  )}

  <section class={styles.hero}>
    <h1 class={styles.heroTitle}>Active Listings</h1>
    <p class={styles.heroSubtitle}>
      {listings.length} vehicle{listings.length !== 1 ? "s" : ""} for sale
    </p>
    <a href="/listings/new" class={styles.ctaBtn}>List a Vehicle</a>
  </section>

  {listings.length === 0 ? (
    <div class={styles.emptyState}>
      <p>No active listings yet.</p>
      <a href="/listings/new" class={styles.emptyLink}>Be the first to list a vehicle.</a>
    </div>
  ) : (
    <>
      <div class={styles.filters} id="listings-filters">
        <input
          type="text"
          class={styles.filterSearch}
          id="filter-search"
          placeholder="Search make, model, year…"
          aria-label="Search listings"
        />
        <select class={styles.filterSelect} id="filter-make" aria-label="Filter by make">
          <option value="">All Makes</option>
          {makes.map((m) => (
            <option value={m}>{m}</option>
          ))}
        </select>
        <select class={styles.filterSelect} id="filter-price" aria-label="Filter by price range">
          <option value="">Any Price</option>
          <option value="0-3000000">Under ₦3M</option>
          <option value="3000000-7000000">₦3M – ₦7M</option>
          <option value="7000000-15000000">₦7M – ₦15M</option>
          <option value="15000000-999999999">Above ₦15M</option>
        </select>
        <select class={styles.filterSelect} id="filter-sort" aria-label="Sort listings">
          <option value="newest">Newest First</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
        </select>
        <span class={styles.filterCount} id="filter-count">{listings.length} vehicle{listings.length !== 1 ? "s" : ""}</span>
      </div>

      <div class={styles.listingsGrid} id="listings-grid">
        {listings.map((item) => {
          const price = Number(item.askingPriceNgn);
          return (
            <a
              href={`/listings/${item.id}`}
              class={styles.listingCard}
              data-make={item.makeName}
              data-model={item.modelName}
              data-year={item.modelYear}
              data-price={price}
            >
              <div class={styles.cardPlaceholder}>
                <span class={styles.cardInitial}>{item.makeName.charAt(0)}</span>
              </div>
              <div class={styles.cardBody}>
                <h2 class={styles.cardTitle}>
                  {item.modelYear} {item.makeName} {item.modelName}
                </h2>
                <p class={styles.cardTrim}>{item.trimName}</p>
                <div class={styles.cardMeta}>
                  <span class={styles.cardMileage}>
                    {item.mileageKm?.toLocaleString() ?? "—"} km
                  </span>
                  <span class={styles.cardPrice}>
                    ₦{price.toLocaleString()}
                  </span>
                </div>
                {item.sellerName && (
                  <p class={styles.cardSeller}>Listed by {item.sellerName}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </>
  )}
</BaseLayout>

<script>
  const grid = document.getElementById("listings-grid")!;
  const search = document.getElementById("filter-search") as unknown as HTMLInputElement;
  const make = document.getElementById("filter-make") as unknown as HTMLSelectElement;
  const price = document.getElementById("filter-price") as unknown as HTMLSelectElement;
  const sort = document.getElementById("filter-sort") as unknown as HTMLSelectElement;
  const count = document.getElementById("filter-count")!;

  void (function initListings() {
    if (!grid || !search || !make || !price || !sort || !count) return;

    const cards = Array.from(grid.querySelectorAll("a")) as unknown as HTMLAnchorElement[];

  function applyFilters() {
    const q = search.value.toLowerCase();
    const m = make.value;
    const p = price.value;
    const s = sort.value;

    let visible = cards.filter((card) => {
      const text = card.textContent?.toLowerCase() ?? "";
      if (q && !text.includes(q)) return false;
      if (m && card.dataset.make !== m) return false;
      if (p) {
        const [min, max] = p.split("-").map(Number);
        const cardPrice = Number(card.dataset.price);
        if (cardPrice < min || cardPrice > max) return false;
      }
      return true;
    });

    if (s === "price-asc") {
      visible.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
    } else if (s === "price-desc") {
      visible.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
    }

    cards.forEach((c) => c.remove());
    visible.forEach((c) => grid.appendChild(c));
    count.textContent = `${visible.length} vehicle${visible.length !== 1 ? "s" : ""}`;
  }

  search.addEventListener("input", applyFilters);
  make.addEventListener("change", applyFilters);
  price.addEventListener("change", applyFilters);
  sort.addEventListener("change", applyFilters);
  })();
</script>
