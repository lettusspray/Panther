---
import BaseLayout from "../../layouts/BaseLayout.astro";
import styles from "./new.module.css";
import "../../styles/global.css";
import { getConditionFields } from "../../lib/listings/condition-reports";
import ConditionReportForm from "../../components/listings/ConditionReportForm.astro";
import PhotoUploader from "../../components/listings/PhotoUploader.astro";
---

<BaseLayout
  title="List a Vehicle"
  posture="walking"
  description="List your vehicle on Panther. GVO-verified identification, structured condition reports, transparent pricing."
>
  <section class={styles.hero}>
    <h1 class={styles.heroTitle}>List a Vehicle</h1>
    <p class={styles.heroSubtitle}>
      Every vehicle on Panther is identified through the Global Vehicle Ontology —
      no free-text, no guesswork. Accurate condition reports increase your lead quality by 5x.
    </p>
  </section>

  <div class={styles.formContainer}>
    {/* Progress Steps */}
      <div class={styles.progress}>
      <div class={`${styles.progressStep} ${styles.progressActive}`} data-step="1">
        <span class={styles.progressNum}>1</span>
        <span class={styles.progressLabel}>Vehicle</span>
      </div>
      <div class={styles.progressDivider}></div>
      <div class={styles.progressStep} data-step="2">
        <span class={styles.progressNum}>2</span>
        <span class={styles.progressLabel}>Identify</span>
      </div>
      <div class={styles.progressDivider}></div>
      <div class={styles.progressStep} data-step="3">
        <span class={styles.progressNum}>3</span>
        <span class={styles.progressLabel}>Condition</span>
      </div>
      <div class={styles.progressDivider}></div>
      <div class={styles.progressStep} data-step="4">
        <span class={styles.progressNum}>4</span>
        <span class={styles.progressLabel}>Photos</span>
      </div>
      <div class={styles.progressDivider}></div>
      <div class={styles.progressStep} data-step="5">
        <span class={styles.progressNum}>5</span>
        <span class={styles.progressLabel}>Review</span>
      </div>
    </div>

    {/* Step 1: Domain Selection */}
    <div class={`${styles.step} ${styles.stepActive}`} data-step="1">
      <h2 class={styles.stepTitle}>What type of vehicle?</h2>
      <p class={styles.stepDesc}>Select the domain that best describes your vehicle.</p>
      <div class={styles.domainGrid}>
        <button class={styles.domainBtn} data-domain="car" data-slug="car">
          <span class={styles.domainEmoji}>🚗</span>
          <span class={styles.domainName}>Car</span>
          <span class={styles.domainDesc}>Sedans, SUVs, pickups, coupes</span>
        </button>
        <button class={styles.domainBtn} data-domain="motorcycle" data-slug="motorcycle">
          <span class={styles.domainEmoji}>🏍️</span>
          <span class={styles.domainName}>Motorcycle</span>
          <span class={styles.domainDesc}>Sport, cruiser, touring, commuter</span>
        </button>
        <button class={styles.domainBtn} data-domain="tricycle" data-slug="tricycle">
          <span class={styles.domainEmoji}>🛺</span>
          <span class={styles.domainName}>Tricycle (Keke)</span>
          <span class={styles.domainDesc}>Passenger and cargo tricycles</span>
        </button>
        <button class={styles.domainBtn} data-domain="commercial" data-slug="commercial">
          <span class={styles.domainEmoji}>🚛</span>
          <span class={styles.domainName}>Commercial</span>
          <span class={styles.domainDesc}>Trucks, buses, heavy-duty vehicles</span>
        </button>
      </div>
    </div>

    {/* Step 2: GVO Cascading Selectors + VIN */}
    <div class={styles.step} data-step="2">
      <h2 class={styles.stepTitle}>Identify the vehicle</h2>
      <p class={styles.stepDesc}>Enter VIN for instant auto-population, or select through the Global Vehicle Ontology.</p>
      <p class={styles.bulkHint}>Listing many vehicles? <a href="/listings/bulk">Use bulk upload →</a></p>

      {/* VIN Decode Section */}
      <div class={styles.vinSection}>
        <div class={styles.vinRow}>
          <input type="text" class={styles.vinInput} id="vin-input" placeholder="Enter 17-character VIN (e.g. 1HGCM82633A123456)" maxlength="17" autocomplete="off" />
          <button type="button" class={styles.vinDecodeBtn} id="vin-decode-btn">Decode VIN</button>
        </div>
        <div class={styles.vinStatus} id="vin-status"></div>
        <div class={styles.vinDivider}><span>or browse the catalog</span></div>
      </div>

      <div class={styles.selectorsGrid}>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Make</label>
          <select id="make-select" class={styles.fieldSelect}>
            <option value="">Select make...</option>
          </select>
        </div>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Model</label>
          <select id="model-select" class={styles.fieldSelect} disabled>
            <option value="">Select make first...</option>
          </select>
        </div>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Trim</label>
          <select id="trim-select" class={styles.fieldSelect} disabled>
            <option value="">Select model first...</option>
          </select>
        </div>
      </div>

      <div class={styles.selectedVehicle} id="selected-vehicle" style="display: none;">
        <span class={styles.selectedLabel}>Selected:</span>
        <span class={styles.selectedText} id="selected-vehicle-text"></span>
      </div>

      <div class={styles.gvoRequestArea}>
        <button type="button" class={styles.gvoRequestBtn} id="gvo-request-btn">
          Can't find your vehicle?
        </button>
        <div class={styles.gvoRequestForm} id="gvo-request-form" hidden>
          <p class={styles.gvoRequestText}>
            Enter your vehicle details. We'll try to look it up in automotive databases. If not found, you can continue with custom details or submit a request to add it.
          </p>
          <input type="text" class={styles.fieldInput} id="gvo-request-domain" hidden value="">
          <div class={styles.fieldGroup}>
            <label class={styles.fieldLabel}>Make</label>
            <input type="text" class={styles.fieldInput} id="gvo-request-make" placeholder="e.g. Toyota, Bajaj, MAN" />
          </div>
          <div class={styles.fieldGroup}>
            <label class={styles.fieldLabel}>Model</label>
            <input type="text" class={styles.fieldInput} id="gvo-request-model" placeholder="e.g. Camry, CT 100, TGS" />
          </div>
          <div class={styles.fieldGroup}>
            <label class={styles.fieldLabel}>Trim / Variant <span class={styles.fieldOptional}>(optional)</span></label>
            <input type="text" class={styles.fieldInput} id="gvo-request-trim" placeholder="e.g. LE, Standard" />
          </div>
          <div class={styles.gvoLookupActions}>
            <button type="button" class={styles.gvoLookupBtn} id="gvo-lookup-btn">Look up vehicle</button>
            <span class={styles.gvoLookupOr}>or</span>
            <button type="button" class={styles.gvoCustomBtn} id="gvo-custom-btn">Continue with custom details</button>
          </div>
          <p class={styles.gvoLookupStatus} id="gvo-lookup-status" hidden></p>
          <div class={styles.gvoRequestDivider}><span>or submit a request</span></div>
          <div class={styles.fieldGroup}>
            <label class={styles.fieldLabel}>Notes <span class={styles.fieldOptional}>(optional)</span></label>
            <textarea class={styles.fieldTextarea} id="gvo-request-notes" rows={2} placeholder="Any additional details to help identify the vehicle."></textarea>
          </div>
          <button type="button" class={styles.gvoRequestSubmit} id="gvo-request-submit">Submit Request</button>
          <p class={styles.gvoRequestStatus} id="gvo-request-status" hidden></p>
        </div>
      </div>

      <div class={styles.stepActions}>
        <button class={styles.btnSecondary} data-goto="1">Back</button>
        <button class={styles.btnPrimary} id="step2-next" disabled>Continue</button>
      </div>
    </div>

    {/* Step 3: Vehicle Details + Condition Report */}
    <div class={styles.step} data-step="3">
      <h2 class={styles.stepTitle}>Vehicle details & condition</h2>
      <p class={styles.stepDesc}>
        Provide accurate details. Honest disclosure is a sales advantage — it increases lead quality by 5x.
      </p>

      <div class={styles.detailsGrid}>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Model Year</label>
          <select id="year-select" class={styles.fieldSelect}>
            <option value="">Select year...</option>
          </select>
        </div>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Mileage (km)</label>
          <input type="number" id="mileage-input" class={styles.fieldInput} min="0" placeholder="e.g. 85000" />
        </div>
        <div class={styles.fieldGroup}>
          <label class={styles.fieldLabel}>Asking Price (₦)</label>
          <input type="number" id="price-input" class={styles.fieldInput} min="1" placeholder="e.g. 4500000" />
        </div>
      </div>

      {/* Condition Report — dynamically populated based on domain */}
      <ConditionReportForm fields={getConditionFields("car")} containerId="condition-fields" />

      <div class={styles.stepActions}>
        <button class={styles.btnSecondary} data-goto="2">Back</button>
        <button class={styles.btnPrimary} id="step3-next">Add Photos</button>
      </div>
    </div>

    {/* Step 4: Photos + Video — Cars & Bids-inspired guidance */}
    <div class={styles.step} data-step="4">
      <h2 class={styles.stepTitle}>Add photos of your vehicle</h2>
      <p class={styles.stepDesc}>
        Good photos sell vehicles. Listings with 6+ clear photos get 5x more buyer interest.
        Disclosure helps you sell — buyers want to see what they're getting.
      </p>

      <PhotoUploader />

      {/* ── Video Section — Aggressively Pushed, Not Required ── */}
      <div class={styles.videoSection}>
        <div class={styles.videoPromo}>
          <span class={styles.videoPromoIcon}>🎥</span>
          <span class={styles.videoPromoTitle}>Add a walkaround video</span>
          <span class={styles.videoPromoDesc}>
            Listings with a walkaround video sell 2x faster. Buyers want to see the car in motion — engine start, interior walkthrough, exterior sweep.
          </span>
        </div>

        <div id="video-count" class={styles.photoCount} style="display: none;">
          <span class={styles.photoCountStrong} id="video-count-num">0</span> videos added
        </div>

        <div id="video-preview" class={styles.photoPreviewGrid}></div>

        <div class={styles.videoUploadArea} id="video-upload-area">
          <div class={styles.photoUploadIcon}>🎬</div>
          <p class={styles.photoUploadText}>Add a walkaround video</p>
          <p class={styles.photoUploadHint}>MP4 or WebM — max 100MB, 2 minutes max</p>
          <input type="file" id="video-input" accept="video/mp4,video/webm" style="display: none;" />
        </div>

        <p class={styles.photoActivationNote}>
          Videos are optional but strongly encouraged. Tag them with the angle they cover.
        </p>
      </div>

      <div class={styles.stepActions}>
        <button class={styles.btnSecondary} data-goto="3">Back</button>
        <button class={styles.btnPrimary} id="step4-next">Review Listing</button>
      </div>
    </div>

    {/* Step 5: Review & Activate */}
    <div class={styles.step} data-step="5">
      <h2 class={styles.stepTitle}>Review your listing</h2>
      <p class={styles.stepDesc}>Verify everything is correct before publishing.</p>

      <div class={styles.reviewCard}>
        <div class={styles.reviewSection}>
          <h3 class={styles.reviewLabel}>Vehicle</h3>
          <p class={styles.reviewValue} id="review-vehicle"></p>
        </div>
        <div class={styles.reviewSection}>
          <h3 class={styles.reviewLabel}>Details</h3>
          <div id="review-details" class={styles.reviewDetails}></div>
        </div>
        <div class={styles.reviewSection}>
          <h3 class={styles.reviewLabel}>Photos</h3>
          <div id="review-photos" class={styles.reviewDetails}></div>
        </div>
        <div class={styles.reviewSection}>
          <h3 class={styles.reviewLabel}>Condition Summary</h3>
          <div id="review-condition" class={styles.reviewCondition}></div>
        </div>
      </div>

      <div id="activation-status"></div>

      <div class={styles.activationActions}>
        <button class={styles.btnActivate} id="activate-btn">Activate Listing</button>
        <button class={styles.btnDraft} id="draft-btn">Save as Draft</button>
      </div>

      <div id="submit-status" class={styles.submitStatus} style="display: none;"></div>
    </div>
  </div>
</BaseLayout>

<script>
  // ── State ────────────────────────────────────────────────────────
  let currentStep = 1;
  let selectedDomain = "";
  let selectedDomainSlug = "";
  let selectedMake = "";
  let selectedModel = "";
  let selectedTrim = "";
  let selectedTrimId = "";
  let isCustomVehicle = false;
  let customMake = "";
  let customModel = "";
  let customTrim = "";
  let selectedPhotos: Array<{ file: File; tag: string; uploadedUrl?: string; uploading?: boolean; uploadError?: string }> = [];
  let selectedVideos: Array<{ file: File; tag: string; uploadedUrl?: string; uploading?: boolean; uploadError?: string }> = [];
  let createdListingId = "";

  // ── DOM References ──────────────────────────────────────────────
  const steps = document.querySelectorAll<HTMLElement>("[data-step]");
  const progressSteps = document.querySelectorAll<HTMLElement>(".progress [data-step]");
  const progressDividers = document.querySelectorAll<HTMLElement>(".progressDivider");
  const domainBtns = document.querySelectorAll<HTMLElement>("[data-domain]");
  const makeSelect = document.getElementById("make-select") as HTMLSelectElement;
  const modelSelect = document.getElementById("model-select") as HTMLSelectElement;
  const trimSelect = document.getElementById("trim-select") as HTMLSelectElement;
  const yearSelect = document.getElementById("year-select") as HTMLSelectElement;
  const mileageInput = document.getElementById("mileage-input") as HTMLInputElement;
  const priceInput = document.getElementById("price-input") as HTMLInputElement;
  const conditionContainer = document.getElementById("condition-fields")!;
  const selectedVehicleEl = document.getElementById("selected-vehicle")!;
  const selectedVehicleText = document.getElementById("selected-vehicle-text")!;
  const step2Next = document.getElementById("step2-next") as HTMLButtonElement;
  const step3Next = document.getElementById("step3-next") as HTMLButtonElement;
  const step4Next = document.getElementById("step4-next") as HTMLButtonElement;
  const activateBtn = document.getElementById("activate-btn") as HTMLButtonElement;
  const draftBtn = document.getElementById("draft-btn") as HTMLButtonElement;
  const submitStatus = document.getElementById("submit-status")!;
  const videoInput = document.getElementById("video-input") as HTMLInputElement;
  const videoUploadArea = document.getElementById("video-upload-area")!;
  const videoPreview = document.getElementById("video-preview")!;
  const videoCount = document.getElementById("video-count")!;
  const videoCountNum = document.getElementById("video-count-num")!;
  const activationStatus = document.getElementById("activation-status")!;

  // ── Step Navigation ─────────────────────────────────────────────
  function goToStep(step: number) {
    currentStep = step;
    steps.forEach((el) => {
      el.classList.toggle("stepActive", Number(el.dataset.step) === step);
    });
    progressSteps.forEach((el) => {
      const s = Number(el.dataset.step);
      el.classList.toggle("progressActive", s === step);
      el.classList.toggle("progressDone", s < step);
    });
    progressDividers.forEach((el, i) => {
      el.classList.toggle("progressDone", i < step - 1);
    });

    if (step === 5) populateReview();
  }

  document.querySelectorAll("[data-goto]").forEach((btn) => {
    btn.addEventListener("click", () => {
      goToStep(Number(btn.getAttribute("data-goto")));
    });
  });

  // ── Step 1: Domain Selection ────────────────────────────────────
  domainBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      selectedDomain = btn.getAttribute("data-domain")!;
      selectedDomainSlug = btn.getAttribute("data-slug")!;
      domainBtns.forEach((b) => b.classList.remove("domainSelected"));
      btn.classList.add("domainSelected");
      loadMakes();
      goToStep(2);
    });
  });

  // ── VIN Decode ─────────────────────────────────────────────────
  const vinInput = document.getElementById("vin-input") as HTMLInputElement | null;
  const vinDecodeBtn = document.getElementById("vin-decode-btn") as HTMLButtonElement | null;
  const vinStatus = document.getElementById("vin-status");

  if (vinInput && vinDecodeBtn && vinStatus) {
    const decodeVin = async () => {
      const vin = vinInput.value.trim().toUpperCase();
      if (vin.length < 11) {
        vinStatus.textContent = "VIN must be at least 11 characters.";
        vinStatus.className = styles.vinStatusError || "vinStatusError";
        vinStatus.style.display = "block";
        return;
      }

      vinDecodeBtn.disabled = true;
      vinDecodeBtn.textContent = "Decoding...";
      vinStatus.textContent = "Decoding VIN...";
      vinStatus.className = "vinStatusPending";
      vinStatus.style.display = "block";

      try {
        const res = await fetch("/api/vin/decode", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ vin, domain: selectedDomain || "car" }),
        });
        const data = await res.json();

        if (res.ok && data.ok && data.trimId) {
          selectedTrimId = data.trimId;
          selectedMake = data.make;
          selectedModel = data.model;
          selectedTrim = data.trim || data.model;

          // Update the selectors to reflect the decoded vehicle
          selectedVehicleEl.style.display = "flex";
          selectedVehicleText.textContent = `${data.make} ${data.model}${data.trim ? " — " + data.trim : ""} (VIN ${vin.slice(0, 8)}…)`;
          step2Next.disabled = false;

          // Auto-populate year
          if (data.year) {
            yearSelect.innerHTML = `<option value="${data.year}">${data.year}</option>`;
            yearSelect.value = String(data.year);
          }

          vinStatus.textContent = `Decoded: ${data.make} ${data.model} ${data.trim || ""} (${data.year || "year unknown"})`;
          vinStatus.className = styles.vinStatusOk || "vinStatusOk";
          vinInput.disabled = true;
          vinDecodeBtn.textContent = "Decoded ✓";
          vinDecodeBtn.disabled = true;
        } else if (res.ok && data.ok && !data.trimId) {
          // VIN decoded but GVO lookup failed — populate as custom
          customMake = data.make;
          customModel = data.model;
          customTrim = data.trim || "";
          isCustomVehicle = true;

          selectedVehicleEl.style.display = "flex";
          selectedVehicleText.textContent = `${data.make} ${data.model}${data.trim ? " — " + data.trim : ""} (VIN decoded, custom entry)`;
          step2Next.disabled = false;

          if (data.year) {
            yearSelect.innerHTML = `<option value="${data.year}">${data.year}</option>`;
            yearSelect.value = String(data.year);
          }

          vinStatus.textContent = `Found: ${data.make} ${data.model} ${data.trim || ""}. Not in GVO yet — will save as custom entry.`;
          vinStatus.className = "vinStatusWarn";
          vinInput.disabled = true;
          vinDecodeBtn.textContent = "Found ✓";
          vinDecodeBtn.disabled = true;
        } else {
          vinStatus.textContent = data.error || "Could not decode VIN. Try selecting manually below.";
          vinStatus.className = styles.vinStatusError || "vinStatusError";
          vinDecodeBtn.disabled = false;
          vinDecodeBtn.textContent = "Decode VIN";
        }
      } catch {
        vinStatus.textContent = "Network error. Try again or select manually.";
        vinStatus.className = styles.vinStatusError || "vinStatusError";
        vinDecodeBtn.disabled = false;
        vinDecodeBtn.textContent = "Decode VIN";
      }
    };

    vinDecodeBtn.addEventListener("click", decodeVin);
    vinInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") { e.preventDefault(); decodeVin(); }
    });
  }

  // ── Step 2: GVO Cascading Selectors ─────────────────────────────
  async function loadMakes() {
    makeSelect.innerHTML = '<option value="">Loading makes...</option>';
    makeSelect.disabled = true;
    modelSelect.innerHTML = '<option value="">Select make first...</option>';
    modelSelect.disabled = true;
    trimSelect.innerHTML = '<option value="">Select model first...</option>';
    trimSelect.disabled = true;
    step2Next.disabled = true;
    selectedVehicleEl.style.display = "none";

    try {
      const domainsRes = await fetch("/api/pricing/gvo/domains");
      const domains = await domainsRes.json();
      const domain = domains.find((d: { slug: string }) => d.slug === selectedDomainSlug);
      if (!domain) return;

      const catsRes = await fetch(`/api/pricing/gvo/categories/${domain.id}`);
      const categories = await catsRes.json();

      let allMakes: Array<{ id: string; name: string; slug: string }> = [];
      for (const cat of categories) {
        const makesRes = await fetch(`/api/pricing/gvo/makes/${cat.id}`);
        const makes = await makesRes.json();
        allMakes.push(...makes);
      }

      const uniqueMakes = Array.from(
        new Map(allMakes.map((m: { name: string }) => [m.name, m])).values(),
      );

      makeSelect.innerHTML = '<option value="">Select make...</option>';
      for (const make of uniqueMakes) {
        const opt = document.createElement("option");
        opt.value = make.id;
        opt.textContent = make.name;
        makeSelect.appendChild(opt);
      }
      makeSelect.disabled = false;
    } catch (err) {
      console.error("Failed to load makes:", err);
      makeSelect.innerHTML = '<option value="">Failed to load makes</option>';
    }
  }

  makeSelect.addEventListener("change", async () => {
    const makeId = makeSelect.value;
    if (!makeId) {
      modelSelect.innerHTML = '<option value="">Select make first...</option>';
      modelSelect.disabled = true;
      trimSelect.innerHTML = '<option value="">Select model first...</option>';
      trimSelect.disabled = true;
      step2Next.disabled = true;
      selectedVehicleEl.style.display = "none";
      return;
    }

    selectedMake = makeSelect.options[makeSelect.selectedIndex].text;
    modelSelect.innerHTML = '<option value="">Loading models...</option>';
    modelSelect.disabled = true;
    trimSelect.innerHTML = '<option value="">Select model first...</option>';
    trimSelect.disabled = true;
    step2Next.disabled = true;

    try {
      const res = await fetch(`/api/pricing/gvo/models/${makeId}`);
      const models = await res.json();
      modelSelect.innerHTML = '<option value="">Select model...</option>';
      for (const model of models) {
        const opt = document.createElement("option");
        opt.value = model.id;
        opt.textContent = model.name;
        opt.dataset.firstYear = model.firstModelYear ?? "";
        opt.dataset.lastYear = model.lastModelYear ?? "";
        modelSelect.appendChild(opt);
      }
      modelSelect.disabled = false;
    } catch (err) {
      console.error("Failed to load models:", err);
    }
  });

  modelSelect.addEventListener("change", async () => {
    const modelId = modelSelect.value;
    if (!modelId) {
      trimSelect.innerHTML = '<option value="">Select model first...</option>';
      trimSelect.disabled = true;
      step2Next.disabled = true;
      selectedVehicleEl.style.display = "none";
      return;
    }

    selectedModel = modelSelect.options[modelSelect.selectedIndex].text;
    trimSelect.innerHTML = '<option value="">Loading trims...</option>';
    trimSelect.disabled = true;
    step2Next.disabled = true;

    try {
      const res = await fetch(`/api/pricing/gvo/trims/${modelId}`);
      const trims = await res.json();
      trimSelect.innerHTML = '<option value="">Select trim...</option>';
      for (const trim of trims) {
        const opt = document.createElement("option");
        opt.value = trim.id;
        opt.textContent = trim.name + (trim.engine ? ` (${trim.engine})` : "");
        trimSelect.appendChild(opt);
      }
      trimSelect.disabled = false;
    } catch (err) {
      console.error("Failed to load trims:", err);
    }
  });

  trimSelect.addEventListener("change", () => {
    const trimId = trimSelect.value;
    if (!trimId) {
      step2Next.disabled = true;
      selectedVehicleEl.style.display = "none";
      return;
    }

    selectedTrimId = trimId;
    selectedTrim = trimSelect.options[trimSelect.selectedIndex].text;

    selectedVehicleEl.style.display = "flex";
    selectedVehicleText.textContent = `${selectedMake} ${selectedModel} — ${selectedTrim}`;
    step2Next.disabled = false;

    const modelOpt = modelSelect.options[modelSelect.selectedIndex];
    const firstYear = Number(modelOpt.dataset.firstYear) || 1990;
    const lastYear = Number(modelOpt.dataset.lastYear) || new Date().getFullYear();
    yearSelect.innerHTML = '<option value="">Select year...</option>';
    for (let y = lastYear; y >= firstYear; y--) {
      const opt = document.createElement("option");
      opt.value = String(y);
      opt.textContent = String(y);
      yearSelect.appendChild(opt);
    }
  });

  // ── Step 3: Condition Report Fields ─────────────────────────────
  const TOGGLE_OPTIONS = ["good", "fair", "poor", "absent"];

  const CONDITION_SCHEMAS: Record<string, Array<{ key: string; label: string; type: string; options?: string[]; required: boolean }>> = {
    car: [
      { key: "exterior_body", label: "Exterior Body Condition", type: "toggle", required: true },
      { key: "paint_quality", label: "Paint Quality", type: "toggle", required: true },
      { key: "interior_upholstery", label: "Interior Upholstery", type: "toggle", required: true },
      { key: "dashboard_instrument_cluster", label: "Dashboard & Instrument Cluster", type: "toggle", required: true },
