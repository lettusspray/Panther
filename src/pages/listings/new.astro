  function buildConditionFields() {
    const fields = CONDITION_SCHEMAS[selectedDomain] ?? CONDITION_SCHEMAS.car;
    conditionContainer.innerHTML = "";

    for (const field of fields) {
      const wrapper = document.createElement("div");
      wrapper.className = "conditionField";

      const label = document.createElement("label");
      label.className = "conditionLabel";
      label.textContent = field.label + (field.required ? " *" : "");
      wrapper.appendChild(label);

      if (field.type === "toggle") {
        const btnGroup = document.createElement("div");
        btnGroup.className = "toggleGroup";
        for (const opt of TOGGLE_OPTIONS) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "toggleBtn";
          btn.dataset.field = field.key;
          btn.dataset.value = opt;
          btn.textContent = opt.charAt(0).toUpperCase() + opt.slice(1);
          btn.addEventListener("click", () => {
            btnGroup.querySelectorAll(".toggleBtn").forEach((b) => b.classList.remove("toggleActive"));
            btn.classList.add("toggleActive");
          });
          btnGroup.appendChild(btn);
        }
        wrapper.appendChild(btnGroup);
      } else if (field.type === "select") {
        const select = document.createElement("select");
        select.className = "fieldSelect";
        select.dataset.field = field.key;
        select.innerHTML = '<option value="">Select...</option>';
        for (const opt of field.options ?? []) {
          const option = document.createElement("option");
          option.value = opt;
          option.textContent = opt.charAt(0).toUpperCase() + opt.slice(1);
          select.appendChild(option);
        }
        wrapper.appendChild(select);
      } else if (field.type === "hours") {
        const input = document.createElement("input");
        input.type = "number";
        input.className = "fieldInput";
        input.dataset.field = field.key;
        input.min = "0";
        input.placeholder = "e.g. 12000";
        wrapper.appendChild(input);
      }

      conditionContainer.appendChild(wrapper);
    }
  }

  step3Next.addEventListener("click", () => {
    if (!yearSelect.value || !mileageInput.value || !priceInput.value) {
      alert("Please fill in model year, mileage, and asking price.");
      return;
    }
    goToStep(4);
  });

  // ── Video Upload ──────────────────────────────────────────────
  videoUploadArea.addEventListener("click", () => videoInput.click());

  videoInput.addEventListener("change", () => {
    const files = videoInput.files;
    if (!files) return;
    for (const file of Array.from(files)) {
      if (!file.type.startsWith("video/")) continue;
      if (file.size > 100 * 1024 * 1024) {
        alert(`${file.name} exceeds 100MB limit.`);
        continue;
      }
      const idx = selectedVideos.length;
      selectedVideos.push({ file, tag: "", uploading: true });
      renderVideoPreview();

      uploadVideoToServer(file)
        .then((url) => {
          selectedVideos[idx].uploadedUrl = url;
          selectedVideos[idx].uploading = false;
          renderVideoPreview();
        })
        .catch((err) => {
          selectedVideos[idx].uploading = false;
          selectedVideos[idx].uploadError = err.message;
          renderVideoPreview();
        });
    }
    videoInput.value = "";
  });

  const PHOTO_TAGS = [
    { value: "", label: "Select angle..." },
    { value: "front", label: "Front" },
    { value: "rear", label: "Rear" },
    { value: "side", label: "Side" },
    { value: "interior", label: "Interior" },
    { value: "dashboard", label: "Dashboard" },
    { value: "engine_bay", label: "Engine Bay" },
  ];

  function renderVideoPreview() {
    videoPreview.innerHTML = "";
    if (selectedVideos.length > 0) {
      videoCount.style.display = "flex";
      videoCountNum.textContent = String(selectedVideos.length);
    } else {
      videoCount.style.display = "none";
    }

    selectedVideos.forEach((entry, idx) => {
      const div = document.createElement("div");
      div.className = "photoPreviewItem";

      if (entry.uploadError) {
        div.style.border = "2px solid #C0392B";
      }

      if (entry.uploading) {
        const spinner = document.createElement("div");
        Object.assign(spinner.style, {
          position: "absolute",
          inset: "0",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          background: "rgba(255,255,255,0.8)",
          zIndex: "2",
          fontSize: "24px",
          color: "var(--panther-eyes-hex)",
        });
        spinner.textContent = "⏳";
        div.appendChild(spinner);
      }

      const vid = document.createElement("video");
      vid.src = entry.uploadedUrl || URL.createObjectURL(entry.file);
      vid.muted = true;
      vid.loop = true;
      vid.style.width = "100%";
      vid.style.height = "100%";
      vid.style.objectFit = "cover";
      vid.addEventListener("mouseenter", () => vid.play());
      vid.addEventListener("mouseleave", () => vid.pause());
      div.appendChild(vid);

      const removeBtn = document.createElement("button");
      removeBtn.className = "photoPreviewRemove";
      removeBtn.textContent = "×";
      removeBtn.addEventListener("click", () => {
        selectedVideos.splice(idx, 1);
        renderVideoPreview();
      });
      div.appendChild(removeBtn);

      const tagSelect = document.createElement("select");
      Object.assign(tagSelect.style, {
        position: "absolute",
        bottom: "0",
        left: "0",
        width: "100%",
        height: "30px",
        padding: "0 8px",
        border: "none",
        borderTop: "1px solid rgba(0,0,0,0.1)",
        borderRadius: "0 0 8px 8px",
        fontFamily: "var(--font-sans)",
        fontSize: "11px",
        background: "rgba(255,255,255,0.95)",
        color: "var(--panther-resting-hex)",
        cursor: "pointer",
      });
      const VIDEO_TAGS = [
        { value: "", label: "Select angle..." },
        { value: "exterior_walkaround", label: "Exterior Walkaround" },
        { value: "interior_walkthrough", label: "Interior Walkthrough" },
        { value: "engine_start", label: "Engine Start & Idle" },
        { value: "drive_test", label: "Drive Test" },
      ];
      for (const opt of VIDEO_TAGS) {
        const option = document.createElement("option");
        option.value = opt.value;
        option.textContent = opt.label;
        if (entry.tag === opt.value) option.selected = true;
        tagSelect.appendChild(option);
      }
      tagSelect.addEventListener("change", () => {
        selectedVideos[idx] = { ...selectedVideos[idx], tag: tagSelect.value };
      });
      div.appendChild(tagSelect);

      videoPreview.appendChild(div);
    });
  }

  step4Next.addEventListener("click", () => goToStep(5));

  // ── Step 5: Review & Activate ───────────────────────────────────
  function collectConditionData() {
    if (window.__collectConditionData) return window.__collectConditionData();
    const data = {};
    conditionContainer.querySelectorAll(".toggleActive").forEach((btn) => {
      data[btn.getAttribute("data-field")] = btn.getAttribute("data-value");
    });
    conditionContainer.querySelectorAll("select").forEach((sel) => {
      if (sel.dataset.field && sel.value) data[sel.dataset.field] = sel.value;
    });
    conditionContainer.querySelectorAll("input[type='number']").forEach((inp) => {
      if (inp.dataset.field && inp.value) data[inp.dataset.field] = inp.value;
    });
    return data;
  }

  function populateReview() {
    const vehicleEl = document.getElementById("review-vehicle")!;
    const detailsEl = document.getElementById("review-details")!;
    const photosEl = document.getElementById("review-photos")!;
    const conditionEl = document.getElementById("review-condition")!;
    const activationStatusEl = document.getElementById("activation-status")!;

    vehicleEl.textContent = isCustomVehicle
      ? `${customMake} ${customModel}${customTrim ? " — " + customTrim : ""} (custom entry)`
      : `${selectedMake} ${selectedModel} — ${selectedTrim}`;

    detailsEl.innerHTML = `
      <div class="reviewRow"><span>Domain</span><span>${selectedDomain}</span></div>
      <div class="reviewRow"><span>Model Year</span><span>${yearSelect.value}</span></div>
      <div class="reviewRow"><span>Mileage</span><span>${Number(mileageInput.value).toLocaleString()} km</span></div>
      <div class="reviewRow"><span>Asking Price</span><span>₦${Number(priceInput.value).toLocaleString()}</span></div>
    `;

    const photoData = window.__photoUploader ? window.__photoUploader.getData() : selectedPhotos.filter((p) => p.tag && p.uploadedUrl).map((p) => ({ tag: p.tag, url: p.uploadedUrl }));
    const photoCount = photoData.length;
    const taggedCount = photoData.length;
    const videoCount = selectedVideos.length;
    const videoTaggedCount = selectedVideos.filter((p) => p.tag).length;
    photosEl.innerHTML = `
      <div class="reviewRow"><span>Photos</span><span>${photoCount} total, ${taggedCount} tagged</span></div>
      <div class="reviewRow"><span>Videos</span><span>${videoCount} total, ${videoTaggedCount} tagged${videoCount > 0 ? "" : " — add one to boost interest"}</span></div>
    `;

    const conditionData = collectConditionData();
    const total = Object.keys(conditionData).length;
    const goodCount = Object.values(conditionData).filter((v) => v === "good").length;
    const fairCount = Object.values(conditionData).filter((v) => v === "fair").length;
    const poorCount = Object.values(conditionData).filter((v) => v === "poor").length;

    conditionEl.innerHTML = `
      <div class="reviewRow"><span>Total fields</span><span>${total}</span></div>
      <div class="reviewRow"><span>Good</span><span>${goodCount}</span></div>
      <div class="reviewRow"><span>Fair</span><span>${fairCount}</span></div>
      <div class="reviewRow"><span>Poor</span><span>${poorCount}</span></div>
    `;

    const untaggedCount = 0;
    const canActivate = photoCount >= 4;
    const videoMissing = selectedVideos.length === 0;
    if (canActivate) {
      const videoPrompt = videoMissing
        ? '<p style="margin-top:var(--space-2);font-family:var(--font-sans);font-size:13px;color:var(--panther-eyes-hex)">💡 Add a walkaround video from the previous step to sell 2x faster.</p>'
        : "";
      activationStatusEl.innerHTML = `
        <div class="activationReady">
          <p class="activationReadyTitle">Ready to activate</p>
          <p class="activationReadyDesc">You have ${selectedPhotos.length} tagged photo(s). Activate to go live.</p>
          ${videoPrompt}
        </div>
      `;
      activateBtn.disabled = false;
    } else {
      const missing = selectedPhotos.length < 4
        ? `Add at least ${4 - selectedPhotos.length} more photo(s) to activate.`
        : `${untaggedCount} photo(s) need an angle tag.`;
      activationStatusEl.innerHTML = `
        <div class="activationIncomplete">
          <p class="activationIncompleteTitle">Cannot activate yet</p>
          <p class="activationIncompleteDesc">${missing} Save as draft and come back later.</p>
        </div>
      `;
      activateBtn.disabled = true;
    }
  }

  // ── Submit: Create Listing + Optional Activate ──────────────────
  async function createListingData() {
    const conditionData = collectConditionData();
    const photoData = window.__photoUploader ? window.__photoUploader.getData() : selectedPhotos
      .filter((p) => p.tag && p.uploadedUrl)
      .map((p) => ({ tag: p.tag, url: p.uploadedUrl }));
    const images = photoData;
    const videos = selectedVideos
      .filter((p) => p.tag && p.uploadedUrl)
      .map((p) => ({ tag: p.tag, url: p.uploadedUrl }));

    const body: Record<string, unknown> = {
      modelYear: Number(yearSelect.value),
      mileageKm: Number(mileageInput.value),
      askingPriceNgn: Number(priceInput.value),
      conditionReport: conditionData,
      images,
      videos,
    };

    if (isCustomVehicle) {
      body.customMake = customMake;
      body.customModel = customModel;
      if (customTrim) body.customTrim = customTrim;
    } else {
      body.trimId = selectedTrimId;
    }

    const res = await fetch("/api/listings", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    return res.json();
  }

  async function activateListingData(listingId: string): Promise<{ ok: boolean; error?: string }> {
    const res = await fetch(`/api/listings/${listingId}/activate`, { method: "POST" });
    return res.json();
  }

  function showStatus(msg: string, type: "success" | "error") {
    submitStatus.style.display = "block";
    submitStatus.textContent = msg;
    submitStatus.className = type === "success"
      ? `submitStatus submitSuccess`
      : `submitStatus submitError`;
  }

  activateBtn.addEventListener("click", async () => {
    if (!confirm("Activate this listing? It will be visible to buyers immediately.")) return;

    activateBtn.disabled = true;
    activateBtn.textContent = "Creating listing...";
    draftBtn.disabled = true;

    try {
      const createResult = await createListingData();
      if (!createResult.ok) {
        showStatus(createResult.error || "Failed to create listing.", "error");
        activateBtn.disabled = false;
        activateBtn.textContent = "Activate Listing";
        draftBtn.disabled = false;
        return;
      }

      createdListingId = createResult.listingId!;
      activateBtn.textContent = "Activating...";

      const activateResult = await activateListingData(createdListingId);
      if (activateResult.ok) {
        showStatus("Listing activated! Redirecting...", "success");
        setTimeout(() => {
          window.location.href = `/listings/${createdListingId}`;
        }, 1200);
      } else {
        showStatus(
          `Listing saved as draft. ${activateResult.error || "Could not activate yet."}`,
          "error",
        );
        activateBtn.textContent = "Activate Listing";
        activateBtn.disabled = false;
        draftBtn.disabled = false;
      }
    } catch {
      showStatus("Network error. Please try again.", "error");
      activateBtn.disabled = false;
      activateBtn.textContent = "Activate Listing";
      draftBtn.disabled = false;
    }
  });

  draftBtn.addEventListener("click", async () => {
    draftBtn.disabled = true;
    draftBtn.textContent = "Saving...";
    activateBtn.disabled = true;

    try {
      const result = await createListingData();
      if (result.ok) {
        showStatus(`Listing saved as draft. You can activate it later from your dashboard.`, "success");
        draftBtn.textContent = "Saved";
      } else {
        showStatus(result.error || "Failed to save listing.", "error");
        draftBtn.disabled = false;
        draftBtn.textContent = "Save as Draft";
        activateBtn.disabled = false;
      }
    } catch {
      showStatus("Network error. Please try again.", "error");
      draftBtn.disabled = false;
      draftBtn.textContent = "Save as Draft";
      activateBtn.disabled = false;
    }
  });

  // GVO Request — "Can't find your vehicle?"
  const gvoRequestBtn = document.getElementById("gvo-request-btn");
  const gvoRequestForm = document.getElementById("gvo-request-form");
  const gvoRequestDomain = document.getElementById("gvo-request-domain") as HTMLInputElement | null;
  const domainBtns = document.querySelectorAll("[data-domain]");

  if (gvoRequestBtn && gvoRequestForm) {
    gvoRequestBtn.addEventListener("click", () => {
      const expanded = gvoRequestBtn.getAttribute("aria-expanded") === "true";
      gvoRequestBtn.setAttribute("aria-expanded", String(!expanded));
      gvoRequestForm.hidden = expanded;
    });

    domainBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const domain = btn.getAttribute("data-domain");
        if (gvoRequestDomain && domain) gvoRequestDomain.value = domain;
      });
    });
  }

  const gvoRequestMake = document.getElementById("gvo-request-make") as HTMLInputElement | null;
  const gvoRequestModel = document.getElementById("gvo-request-model") as HTMLInputElement | null;
  const gvoRequestTrim = document.getElementById("gvo-request-trim") as HTMLInputElement | null;
  const gvoRequestNotes = document.getElementById("gvo-request-notes") as HTMLTextAreaElement | null;
  const gvoRequestStatus = document.getElementById("gvo-request-status");
  const gvoLookupStatus = document.getElementById("gvo-lookup-status");
  const gvoLookupBtn = document.getElementById("gvo-lookup-btn") as HTMLButtonElement | null;
  const gvoCustomBtn = document.getElementById("gvo-custom-btn") as HTMLButtonElement | null;

  function setGvoFormDisabled(disabled: boolean) {
    if (gvoRequestMake) gvoRequestMake.disabled = disabled;
    if (gvoRequestModel) gvoRequestModel.disabled = disabled;
    if (gvoRequestTrim) gvoRequestTrim.disabled = disabled;
    if (gvoLookupBtn) gvoLookupBtn.disabled = disabled;
    if (gvoCustomBtn) gvoCustomBtn.disabled = disabled;
  }

  // Look up vehicle via NHTSA API
  if (gvoLookupBtn && gvoRequestMake && gvoRequestModel && gvoLookupStatus && gvoRequestDomain) {
    gvoLookupBtn.addEventListener("click", async () => {
      const domain = gvoRequestDomain.value;
      if (!domain) {
        gvoLookupStatus.textContent = "Please select a vehicle domain first (Step 1).";
        gvoLookupStatus.hidden = false;
        gvoLookupStatus.style.color = "#C0392B";
        return;
      }
      const makeName = gvoRequestMake.value.trim();
      const modelName = gvoRequestModel.value.trim();
      if (!makeName || !modelName) {
        gvoLookupStatus.textContent = "Make and model are required.";
        gvoLookupStatus.hidden = false;
        gvoLookupStatus.style.color = "#C0392B";
        return;
      }

      gvoLookupBtn.disabled = true;
      gvoLookupBtn.textContent = "Looking up...";

      try {
        const res = await fetch("/api/gvo/lookup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            domain,
            makeName,
            modelName,
            trimName: gvoRequestTrim?.value.trim() || "",
            vehicleType: domain,
          }),
        });
        const data = await res.json();
        if (data.found && data.trimId) {
          gvoLookupStatus.textContent = `Found: ${data.makeName} ${data.modelName}. Adding to GVO...`;
          gvoLookupStatus.style.color = "#2E7D32";
          gvoLookupStatus.hidden = false;

          customMake = data.makeName;
          customModel = data.modelName;
          customTrim = gvoRequestTrim?.value.trim() || data.modelName;
          selectedTrimId = data.trimId;
          isCustomVehicle = false;

          selectedVehicleEl.style.display = "flex";
          selectedVehicleText.textContent = `${customMake} ${customModel} — ${customTrim}`;
          step2Next.disabled = false;
          gvoRequestForm.hidden = true;
          gvoRequestBtn.style.display = "none";
        } else {
          gvoLookupStatus.textContent = `Could not find "${makeName} ${modelName}" in databases. You can continue with custom details or submit a request.`;
          gvoLookupStatus.style.color = "#8B6914";
          gvoLookupStatus.hidden = false;
        }
      } catch {
        gvoLookupStatus.textContent = "Network error during lookup.";
        gvoLookupStatus.style.color = "#C0392B";
        gvoLookupStatus.hidden = false;
      }

      gvoLookupBtn.disabled = false;
      gvoLookupBtn.textContent = "Look up vehicle";
    });
  }

  // Continue with custom details (no GVO lookup found)
  if (gvoCustomBtn && gvoRequestMake && gvoRequestModel) {
    gvoCustomBtn.addEventListener("click", () => {
      const makeName = gvoRequestMake.value.trim();
      const modelName = gvoRequestModel.value.trim();
      if (!makeName || !modelName) {
        if (gvoLookupStatus) {
          gvoLookupStatus.textContent = "Make and model are required.";
          gvoLookupStatus.hidden = false;
          gvoLookupStatus.style.color = "#C0392B";
        }
        return;
      }

      customMake = makeName;
      customModel = modelName;
      customTrim = gvoRequestTrim?.value.trim() || "";
      isCustomVehicle = true;
      selectedTrimId = "";

      selectedVehicleEl.style.display = "flex";
      selectedVehicleText.textContent = `${customMake} ${customModel}${customTrim ? " — " + customTrim : ""} (custom entry)`;
      step2Next.disabled = false;
      gvoRequestForm.hidden = true;
      gvoRequestBtn.style.display = "none";
    });
  }

  // Submit GVO request (existing mechanism)
  const gvoRequestSubmit = document.getElementById("gvo-request-submit");
  if (gvoRequestSubmit && gvoRequestMake && gvoRequestModel && gvoRequestStatus && gvoRequestDomain) {
    gvoRequestSubmit.addEventListener("click", async () => {
      const domain = gvoRequestDomain.value;
      if (!domain) {
        gvoRequestStatus.textContent = "Please select a vehicle domain first (Step 1).";
        gvoRequestStatus.hidden = false;
        gvoRequestStatus.style.color = "#C0392B";
        return;
      }
      const makeName = gvoRequestMake.value.trim();
      const modelName = gvoRequestModel.value.trim();
      if (!makeName || !modelName) {
        gvoRequestStatus.textContent = "Make and model are required.";
        gvoRequestStatus.hidden = false;
        gvoRequestStatus.style.color = "#C0392B";
        return;
      }

      gvoRequestSubmit.disabled = true;
      gvoRequestSubmit.textContent = "Submitting...";

      try {
        const res = await fetch("/api/gvo/request", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            domain,
            makeName,
            modelName,
            trimName: gvoRequestTrim?.value.trim() || "",
            notes: gvoRequestNotes?.value.trim() || "",
          }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          gvoRequestStatus.textContent = "Request submitted. We'll review and add this vehicle.";
          gvoRequestStatus.style.color = "#2E7D32";
          gvoRequestSubmit.hidden = true;
          setGvoFormDisabled(true);
        } else {
          gvoRequestStatus.textContent = data.error || "Failed to submit request.";
          gvoRequestStatus.style.color = "#C0392B";
          gvoRequestSubmit.disabled = false;
          gvoRequestSubmit.textContent = "Submit Request";
        }
      } catch {
        gvoRequestStatus.textContent = "Network error. Please try again.";
        gvoRequestStatus.style.color = "#C0392B";
        gvoRequestSubmit.disabled = false;
        gvoRequestSubmit.textContent = "Submit Request";
      }
      gvoRequestStatus.hidden = false;
    });
  }
</script>
