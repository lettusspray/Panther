---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getListing } from "../../lib/marketplace";
import { getVehicleCareEvents } from "../../lib/dealer";
import { vehicleJsonLd, breadcrumbJsonLd } from "../../lib/seo";

const listing = Astro.params.id ? await getListing(Astro.params.id) : null;
if (!listing) Astro.response.status = 404;

const title = listing
  ? [listing.modelYear, listing.make || listing.customMake, listing.model || listing.customModel, listing.trim || listing.customTrim].filter(Boolean).join(" ")
  : "Vehicle not found";
const images = listing && Array.isArray(listing.images) ? listing.images : [];
const care = listing ? await getVehicleCareEvents(listing.id) : [];
const money = listing?.askingPriceNgn
  ? new Intl.NumberFormat("en-NG", { style: "currency", currency: "NGN", maximumFractionDigits: 0 }).format(Number(listing.askingPriceNgn))
  : "Price on request";
const schema = listing
  ? {
      "@context": "https://schema.org",
      "@graph": [
        vehicleJsonLd({
          name: title,
          description: `${title} available on Panther.`,
          url: `/listings/${listing.id}`,
          image: images[0]?.url,
          price: listing.askingPriceNgn?.toString(),
          currency: "NGN",
          sellerName: listing.businessName,
          year: Number(listing.modelYear),
          mileageKm: listing.mileageKm,
        }),
        breadcrumbJsonLd([
          { name: "Marketplace", url: "/listings" },
          { name: title, url: `/listings/${listing.id}` },
        ]),
      ],
    }
  : undefined;
---
<BaseLayout title={`${title} — Panther`} schema={schema}>
  <section class="section">
    <div class="shell">
      {listing ? (
        <>
          <a class="back-link" href="/listings">← Back to marketplace</a>
          <div class="detail-grid">
            <div>
              <div class="gallery-main">
                {images[0]?.url ? <img src={images[0].url} alt={title} /> : <img src="/car-placeholder.svg" alt="Vehicle placeholder" />}
              </div>
              {images.length > 1 && (
                <div class="gallery-row">
                  {images.slice(1, 6).map((img: any) => <img src={img.url} alt={`${title} gallery`} loading="lazy" />)}
                </div>
              )}
            </div>

            <div class="purchase-card">
              <p class="eyebrow">VEHICLE LISTING</p>
              <h1>{title}</h1>
              <p class="price large">{money}</p>
              <div class="spec-grid">
                <div><span>Year</span><b>{listing.modelYear}</b></div>
                <div><span>Mileage</span><b>{listing.mileageKm != null ? `${new Intl.NumberFormat("en-NG").format(Number(listing.mileageKm))} km` : "Not supplied"}</b></div>
                <div><span>Engine</span><b>{listing.engine || "See vehicle details"}</b></div>
                <div><span>Transmission</span><b>{listing.transmission || "See vehicle details"}</b></div>
              </div>
              <div class="trust-box">
                <strong>{listing.businessName || "Private seller"}</strong>
                <span>{listing.dealerVerified ? "Verified business" : "Seller profile available"}</span>
                {listing.inspectionAvailable && <span>Inspection available</span>}
                {listing.deliveryAvailable && <span>Delivery available</span>}
              </div>
              <div class="cta-stack">
                <a class="button primary full" href={`/checkout?listings=${listing.id}`}>Buy this vehicle</a>
                {listing.dealerSlug && <a class="button secondary full" href={`/dealers/${listing.dealerSlug}`}>View seller</a>}
              </div>
              <p class="fine-print">Payment is handled through Panther's structured transaction flow. Do not send money directly to a seller based on this page.</p>
            </div>
          </div>

          {care.length > 0 && (
            <div class="info-card">
              <p class="eyebrow">VEHICLE HISTORY</p>
              {care.map((event: any) => (
                <div class="ops-row">
                  <div>
                    <b>{event.title}</b>
                    <span>{new Date(event.eventDate).toLocaleDateString("en-NG")} · {event.type.replaceAll("_", " ")}</span>
                  </div>
                  {event.mileageKm != null && <span>{new Intl.NumberFormat("en-NG").format(Number(event.mileageKm))} km</span>}
                </div>
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="empty-state">
          <h1>Vehicle not found</h1>
          <p>This listing may have been removed or is no longer active.</p>
          <a class="button secondary" href="/listings">Back to marketplace</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
