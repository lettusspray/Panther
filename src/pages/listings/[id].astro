---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getListing } from "../../lib/marketplace";
const listing=Astro.params.id?await getListing(Astro.params.id):null;
if(!listing){Astro.response.status=404;}
const title=listing?[listing.modelYear,listing.make||listing.customMake,listing.model||listing.customModel,listing.trim||listing.customTrim].filter(Boolean).join(" "):"Vehicle not found";
const images=listing&&Array.isArray(listing.images)?listing.images:[]; const money=listing?.askingPriceNgn?new Intl.NumberFormat("en-NG",{style:"currency",currency:"NGN",maximumFractionDigits:0}).format(Number(listing.askingPriceNgn)):"Price on request";
---
<BaseLayout title={`${title} — Panther`}><section class="section"><div class="shell">{listing?<><a class="back-link" href="/listings">← Back to marketplace</a><div class="detail-grid"><div><div class="gallery-main">{images[0]?.url?<img src={images[0].url} alt={title}/>:<img src="/car-placeholder.svg" alt="Vehicle placeholder"/>}</div>{images.length>1&&<div class="gallery-row">{images.slice(1,6).map((img:any)=><img src={img.url} alt={`${title} gallery`} loading="lazy"/>)}</div>}</div><div class="purchase-card"><p class="eyebrow">VEHICLE LISTING</p><h1>{title}</h1><p class="price large">{money}</p><div class="spec-grid"><div><span>Year</span><b>{listing.modelYear}</b></div><div><span>Mileage</span><b>{listing.mileageKm!=null?`${new Intl.NumberFormat("en-NG").format(Number(listing.mileageKm))} km`:"Not supplied"}</b></div><div><span>Engine</span><b>{listing.engine||"See vehicle details"}</b></div><div><span>Transmission</span><b>{listing.transmission||"See vehicle details"}</b></div></div><div class="trust-box"><strong>{listing.businessName||"Private seller"}</strong><span>{listing.dealerVerified?"Verified business":"Seller profile available"}</span>{listing.inspectionAvailable&&<span>Inspection available</span>}{listing.deliveryAvailable&&<span>Delivery available</span>}</div><div class="cta-stack"><a class="button primary full" href={`/checkout?listings=${listing.id}`}>Buy this vehicle</a><a class="button secondary full" href={`/dealers/${listing.dealerSlug||""}`}>View seller</a></div><p class="fine-print">Payment is handled through Panther's structured transaction flow. Do not send money directly to a seller based on this page.</p></div></div></> : <div class="empty-state"><h1>Vehicle not found</h1><p>This listing may have been removed or is no longer active.</p><a class="button secondary" href="/listings">Back to marketplace</a></div>}</div></section></BaseLayout>
