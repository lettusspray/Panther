---
import Icon from "./Icon.astro";
import type { IconName } from "@/lib/design-system/icons";

export interface Props {
  label: string;
  href?: string;
  variant?: "primary" | "secondary" | "tertiary" | "danger" | "ghost";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  icon?: IconName;
  iconRight?: boolean;
  full?: boolean;
  disabled?: boolean;
  loading?: boolean;
  class?: string;
  id?: string;
  style?: string;
  "aria-expanded"?: boolean;
}

const {
  label,
  href,
  variant = "primary",
  size = "md",
  type = "button",
  icon,
  iconRight = false,
  full = false,
  disabled = false,
  loading = false,
  id,
  class: className,
} = Astro.props;

const variantClass = variant === "ghost" ? "btn-tertiary" : `btn-${variant}`;
const sizeClass = `btn-${size}`;
const dataAttrs = Object.fromEntries(
  Object.entries(Astro.props).filter(([k]) => k.startsWith("data-")),
);
const ariaAttrs = Object.fromEntries(
  Object.entries(Astro.props).filter(([k]) => k.startsWith("aria-")),
);
const rest = Object.fromEntries(
  Object.entries(Astro.props).filter(
    ([k]) =>
      ![
        "label",
        "href",
        "variant",
        "size",
        "type",
        "icon",
        "iconRight",
        "full",
        "disabled",
        "loading",
        "class",
        "id",
        ...Object.keys(dataAttrs),
        ...Object.keys(ariaAttrs),
      ].includes(k),
  ),
);

const classes = [
  "btn",
  variantClass,
  sizeClass,
  full ? "btn-full" : "",
  loading ? "is-loading" : "",
  className || "",
]
  .filter(Boolean)
  .join(" ");

const iconSize = size === "lg" ? 20 : size === "sm" ? 14 : 16;
---

{
  href ? (
    <a href={href} class={classes} id={id} aria-busy={loading || undefined} {...dataAttrs} {...ariaAttrs} {...rest}>
      <span class="btn-spinner" aria-hidden="true"></span>
      {icon && !iconRight ? <Icon name={icon} size={iconSize} class="btn-icon" /> : null}
      <span class="btn-label">{label}</span>
      {icon && iconRight ? <Icon name={icon} size={iconSize} class="btn-icon" /> : null}
    </a>
  ) : (
    <button type={type} class={classes} id={id} disabled={disabled || loading} aria-busy={loading || undefined} {...dataAttrs} {...ariaAttrs} {...rest}>
      <span class="btn-spinner" aria-hidden="true"></span>
      {icon && !iconRight ? <Icon name={icon} size={iconSize} class="btn-icon" /> : null}
      <span class="btn-label">{label}</span>
      {icon && iconRight ? <Icon name={icon} size={iconSize} class="btn-icon" /> : null}
    </button>
  )
}
