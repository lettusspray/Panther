---
import { ICON_PATHS, type IconName } from "@/lib/design-system/icons";

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  id?: string;
}

const { name, size = 24, class: className, label, id } = Astro.props;
const title = label ? label : undefined;
---

<svg
  id={id}
  class={className}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={title}
>
  <Fragment set:html={ICON_PATHS[name]} />
</svg>
