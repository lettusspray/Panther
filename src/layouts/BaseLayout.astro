---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | null;
}
const {
  title = "Panther — Buy, sell and source cars",
  description = "A trusted automotive marketplace for Nigeria, with vehicle intelligence, verified sellers and structured cross-border buying.",
  canonical,
  image,
  noindex = false,
  schema = null,
} = Astro.props;
const canonicalPath = canonical ?? Astro.url.pathname;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead title={title} description={description} path={canonicalPath} image={image} noindex={noindex} schema={schema} />
  </head>
  <body>
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
