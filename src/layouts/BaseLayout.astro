---
export interface Props {
  title: string;
  description?: string;
  posture?: "roaring" | "walking" | "eyes" | "resting";
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = "The trusted pricing and transaction platform for Nigerian vehicle buyers and sellers.",
  posture = "roaring",
  jsonLd,
} = Astro.props;

const postureClass = `posture-${posture}`;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Panther</title>
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    {jsonLd?.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class={postureClass}>
    <header class="site-header">
      <div class="container-walking header-inner">
        <a href="/" class="logo font-serif">
          Panther
        </a>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="/pricing" class="nav-link">Pricing</a></li>
            <li><a href="/vehicles" class="nav-link">Vehicles</a></li>
            <li><a href="/listings" class="nav-link">Listings</a></li>
            <li><a href="/switchboard" class="nav-link">Escrow</a></li>
          </ul>
        </nav>
        <div class="header-actions">
          {user ? (
            <a href="/dashboard" class="btn btn-secondary btn-sm">{user.name ?? "Dashboard"}</a>
          ) : (
            <a href="/auth/sign-in" class="btn btn-secondary btn-sm">Sign In</a>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-walking footer-inner">
        <p class="footer-text font-sans">
          Panther — Trust is the product. Math is the foundation.
        </p>
        <div class="footer-links">
          <a href="/pricing">Pricing</a>
          <a href="/vehicles">Vehicles</a>
          <a href="/listings">Listings</a>
          <a href="/switchboard">Escrow</a>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-bottom: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 20%, transparent);
        z-index: 100;
        height: 64px;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }

      .logo {
        font-size: 24px;
        color: var(--panther-resting-hex);
      }

      .nav-list {
        display: flex;
        list-style: none;
        gap: var(--space-8);
      }

      .nav-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--panther-eyes-hex);
        transition: color 200ms ease;
      }

      .nav-link:hover {
        color: var(--panther-roaring-hex);
      }

      .header-actions {
        display: flex;
        gap: var(--space-4);
      }

      main {
        padding-top: 64px;
        min-height: calc(100vh - 128px);
      }

      .site-footer {
        border-top: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 20%, transparent);
        padding: var(--space-8) 0;
        background: color-mix(in oklch, var(--panther-resting-hex) 3%, #fff);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .footer-text {
        font-size: 12px;
        color: var(--panther-eyes-hex);
      }

      .footer-links {
        display: flex;
        gap: var(--space-6);
        font-size: 12px;
      }

      .footer-links a {
        color: var(--panther-eyes-hex);
        transition: color 200ms ease;
      }

      .footer-links a:hover {
        color: var(--panther-roaring-hex);
      }

      @media (max-width: 768px) {
        .nav-list {
          gap: var(--space-4);
        }

        .footer-inner {
          flex-direction: column;
          gap: var(--space-4);
          text-align: center;
        }
      }
    </style>
  </body>
</html>
