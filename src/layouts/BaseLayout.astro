---
import "../styles/postures.css";
import Button from "@/components/ui/Button.astro";

export interface Props {
  title: string;
  description?: string;
  posture?: "roaring" | "walking" | "eyes" | "resting";
  theme?: "light" | "dark";
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  ogUrl?: string;
  ogType?: "website" | "article" | "profile";
}

const {
  title,
  description = "The trusted pricing and transaction platform for Nigerian vehicle buyers and sellers.",
  posture = "roaring",
  theme = "light",
  jsonLd,
  ogImage,
  ogUrl,
  ogType = "website",
} = Astro.props;

const siteName = "Panther";
const fullTitle = ogType === "profile" ? title : `${title} | ${siteName}`;

const postureClass = `posture-${posture}`;
const themeClass = theme === "dark" ? "theme-dark" : "";
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <title>{fullTitle}</title>
    <link rel="canonical" href={ogUrl ?? "https://panther.ng"} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    {jsonLd?.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class={postureClass + (themeClass ? ` ${themeClass}` : "")}>
    <header class="site-header">
      <div class="container-walking header-inner">
        <a href="/" class="logo font-serif">
          Panther
        </a>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="/pricing" class="nav-link">Pricing</a></li>
            <li><a href="/vehicles" class="nav-link">Vehicles</a></li>
            <li><a href="/listings" class="nav-link">Listings</a></li>
            <li><a href="/switchboard" class="nav-link">Escrow</a></li>
          </ul>
        </nav>
        <div class="header-actions">
          {user ? (
            <Button label={user.name ?? "Dashboard"} href="/dashboard" variant="secondary" size="sm" />
          ) : (
            <Button label="Sign In" href="/auth/sign-in" variant="secondary" size="sm" />
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-walking footer-inner">
        <p class="footer-text font-sans">
          Panther
        </p>
        <div class="footer-links">
          <a href="/pricing">Pricing</a>
          <a href="/vehicles">Vehicles</a>
          <a href="/listings">Listings</a>
          <a href="/switchboard">Escrow</a>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: #fff;
        border-bottom: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 20%, transparent);
        z-index: 100;
        height: 64px;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }

      .logo {
        font-size: 24px;
        color: var(--panther-resting-hex);
      }

      .nav-list {
        display: flex;
        list-style: none;
        gap: var(--space-8);
      }

      .nav-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--panther-eyes-hex);
        transition: color 200ms ease;
      }

      .nav-link:hover {
        color: var(--panther-roaring-hex);
      }

      .header-actions {
        display: flex;
        gap: var(--space-4);
      }

      main {
        padding-top: 64px;
        min-height: calc(100vh - 128px);
      }

      .site-footer {
        border-top: 1px solid color-mix(in oklch, var(--panther-eyes-hex) 20%, transparent);
        padding: var(--space-8) 0;
        background: color-mix(in oklch, var(--panther-resting-hex) 3%, #fff);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .footer-text {
        font-size: 12px;
        color: var(--panther-eyes-hex);
      }

      .footer-links {
        display: flex;
        gap: var(--space-6);
        font-size: 12px;
      }

      .footer-links a {
        color: var(--panther-eyes-hex);
        transition: color 200ms ease;
      }

      .footer-links a:hover {
        color: var(--panther-roaring-hex);
      }

      /* ── Dark theme (§12): Roaring marketing zone only ─────── */
      .theme-dark .site-header {
        background: var(--dark-bg);
        border-bottom-color: var(--dark-border);
      }

      .theme-dark .logo {
        color: var(--dark-ink);
      }

      .theme-dark .nav-link {
        color: var(--dark-body);
      }

      .theme-dark .nav-link:hover {
        color: var(--dark-accent);
      }

      .theme-dark .site-footer {
        background: color-mix(in oklch, var(--dark-bg) 100%, transparent);
        border-top-color: var(--dark-border);
      }

      .theme-dark .footer-text,
      .theme-dark .footer-links a {
        color: var(--dark-muted);
      }

      .theme-dark .footer-links a:hover {
        color: var(--dark-accent);
      }

      @media (max-width: 768px) {
        .nav-list {
          gap: var(--space-4);
        }

        .footer-inner {
          flex-direction: column;
          gap: var(--space-3);
          text-align: center;
        }
      }
    </style>
  </body>
</html>
