{
  "name": "panther",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "design:lint": "tsx scripts/design-lint.ts",
    "typecheck": "astro check",
    "deploy": "astro build && wrangler pages deploy dist",
    "deploy:all": "npm run build && npm run db:migrate && wrangler pages deploy dist",
    "db:seed:launch": "tsx scripts/seed-launch.ts",
    "worker:deploy": "wrangler deploy -c wrangler.workers.toml",
    "worker:build": "wrangler deploy --dry-run --outdir=dist-worker -c wrangler.workers.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@neondatabase/serverless": "^0.10.0",
    "astro": "^7.1.2",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@eslint/js": "^9.28.0",
    "@phosphor-icons/core": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "impeccable": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.10"
  }
}
