# Neon Postgres (via Cloudflare Hyperdrive)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
HYPERDRIVE_ID=xxx
# Set by Cloudflare at runtime when Hyperdrive is bound:
# HYPERDRIVE_CONNECTION_STRING=postgresql://...

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx

# Auth
BETTER_AUTH_SECRET=generate-a-random-secret
BETTER_AUTH_URL=http://localhost:4321

# WhatsApp Authentication (Constitution §VI.3 — Zero-Cost Inbound Auth)
WHATSAPP_BUSINESS_NUMBER=2348012345678
WHATSAPP_VERIFY_TOKEN=panther-verify-token-xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_APP_SECRET=xxx
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/panther

# External APIs
NHTSA_VPIC_API_URL=https://vpic.nhtsa.dot.gov/api

# auto.dev: Growth plan, structured automotive data (pricing, specs, VIN decode)
AUTO_DEV_API_URL=https://api.auto.dev
AUTO_DEV_API_KEY=sk_ad_xxx

# ScraperAPI: comma-separated keys for full-force scraping
SCRAPER_API_KEYS=your-scraperapi-key-1,your-scraperapi-key-2

# Groq (offline ETL only — never called at runtime)
GROQ_API_KEY=xxx

# Vehicle Images — Multi-Provider
# Unsplash: primary stock photos
UNSPLASH_ACCESS_KEY=xxx
# Pexels: secondary stock photos
PEXELS_API_KEY=xxx
# CarImages: vehicle-specific studio photos
CARIMAGES_API_KEY=ci_xxx
CARIMAGES_API_SECRET=xxx
# SourceSplash: hotlink-ready aggregator fallback
SOURCESPLASH_API_KEY=xxx

# Cloudflare Images
CF_IMAGES_ACCOUNT=xxx
CF_IMAGES_API_TOKEN=xxx

# R2 (S3-compatible, for video storage)
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_ACCOUNT_ID=xxx
R2_BUCKET_NAME=panther-videos
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Crawl4AI: Self-hosted Crawl4AI instance (Railway)
CRAWL4AI_API_URL=https://crawl4ai-your-instance.up.railway.app
CRAWL4AI_API_KEY=your-crawl4ai-api-token-from-railway

# Payment Provider — Paystack (Constitution §X.4)
# Switchboard escrow: PSP is a dumb pipe; state machine lives in Neon
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Webhook secret for HMAC-SHA512 signature verification (set in Paystack dashboard)
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Marketplace payments
# Paystack remains the NGN card/bank customer rail.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# NOWPayments crypto collection (server-side only)
NOWPAYMENTS_API_KEY=npx_xxx
NOWPAYMENTS_IPN_SECRET=ipn_xxx

# Comma-separated Panther administrator emails for seller settlement operations
PANTHER_ADMIN_EMAILS=admin@example.com

# Public site origin used for canonical URLs, sitemap, robots and JSON-LD
PUBLIC_SITE_URL=https://panther.ng
